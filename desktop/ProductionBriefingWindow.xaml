<Window x:Class="Desktop.ProductionBriefingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production Briefing &amp; AI Context" Width="680" MinHeight="500"
        Background="#141416" Foreground="#E4E4E7" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- Custom Expander Style -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Label Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CaretBrush" Value="#FF9800"/>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 PRODUCTION BRIEFING &amp; AI CONTEXT" Foreground="#FF9800" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="#3D3D44" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtStatus" Text="No Briefing" Margin="0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Template Selector Bar -->
        <Border Grid.Row="1" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Template:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbTemplates" Width="220" Height="30" SelectionChanged="CmbTemplates_SelectionChanged" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSaveTemplate" Content="Save as Template..." Click="BtnSaveTemplate_Click" Height="30" Background="#2A2A30" Foreground="#FF9800"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form Accordion ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel>
                
                <!-- 1. Event Details -->
                <Expander Header="1. Event Details (Required)" IsExpanded="True">
                    <StackPanel Margin="6">
                        <TextBlock Text="Event Type" FontWeight="Bold" FontSize="11" Foreground="#FF9800" Margin="0,4,0,4"/>
                        <ComboBox x:Name="CmbEventType" Height="32" SelectionChanged="CmbEventType_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="Concert / Live Music"/>
                            <ComboBoxItem Content="Conference / Keynote"/>
                            <ComboBoxItem Content="Wedding"/>
                            <ComboBoxItem Content="Religious Service / Sermon"/>
                            <ComboBoxItem Content="Theater / Performance"/>
                            <ComboBoxItem Content="Corporate Event / Product Launch"/>
                            <ComboBoxItem Content="Sports"/>
                            <ComboBoxItem Content="Talk Show / Interview"/>
                            <ComboBoxItem Content="Awards Show"/>
                            <ComboBoxItem Content="Talent Show / Competition"/>
                            <ComboBoxItem Content="Panel Discussion"/>
                            <ComboBoxItem Content="Comedy / Stand-Up"/>
                            <ComboBoxItem Content="Dance / Ballet"/>
                            <ComboBoxItem Content="Worship / Concert (Christian/Gospel)"/>
                            <ComboBoxItem Content="Cultural / Traditional Ceremony"/>
                            <ComboBoxItem Content="Graduation / Commencement"/>
                            <ComboBoxItem Content="Custom (free text)"/>
                        </ComboBox>
                        
                        <TextBox x:Name="TxtCustomEventType" Visibility="Collapsed" TextChanged="Field_TextChanged" 
                                 ToolTip="Enter your custom event type"/>

                        <TextBlock Text="Event Narrative" FontWeight="Bold" FontSize="11" Foreground="#FF9800" Margin="0,8,0,2"/>
                        <TextBlock Text="Describe the event, talent, emotion, key moments, and directorial expectations." FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtNarrative" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" TextChanged="Field_TextChanged"
                                 Text="E.g., A 90-minute gospel concert featuring lead vocalist Anya and a 6-piece band. The audience is expecting a worship-driven set building to a high-energy climax at the bridge of the third song. There's a key moment around minute 45 when Anya invites a young fan on stage. The mood is celebratory and emotional throughout." Foreground="#A1A1AA" GotFocus="TxtNarrative_GotFocus" LostFocus="TxtNarrative_LostFocus"/>
                    </StackPanel>
                </Expander>

                <!-- 2. Venue & Environment -->
                <Expander Header="2. Venue &amp; Environment (Required)">
                    <StackPanel Margin="6">
                        <TextBlock Text="Venue Description" FontWeight="Bold" FontSize="11" Foreground="#FF9800" Margin="0,4,0,2"/>
                        <TextBlock Text="Describe venue size, stage layout, seating arrangement, lighting setup, and visual highlights." FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtVenueDescription" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" TextChanged="Field_TextChanged"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnUploadPhotos" Content="📁 Upload Venue Photos" Click="BtnUploadPhotos_Click" Background="#2A2A30"/>
                            <Button x:Name="BtnAutoDescribe" Content="✨ Auto-Describe via Vision AI" Click="BtnAutoDescribe_Click" Background="#00C853" Foreground="White" Visibility="Collapsed"/>
                        </StackPanel>
                        <WrapPanel x:Name="PhotoThumbnails" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- 3. Event Flow -->
                <Expander Header="3. Event Flow / Run-of-Show (Optional)">
                    <StackPanel Margin="6">
                        <DataGrid x:Name="FlowGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" 
                                  Background="#18181B" Foreground="#E4E4E7" RowBackground="#1E1E22" AlternatingRowBackground="#25252A"
                                  HeadersVisibility="Column" MinHeight="140" MaxHeight="220" BorderBrush="#3D3D44" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70"/>
                                <DataGridTextColumn Header="Segment Name" Binding="{Binding Name}" Width="170"/>
                                <DataGridTextColumn Header="Directorial Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="BtnGenerateFlow" Content="🤖 AI: Generate Flow from Narrative" Click="BtnGenerateFlow_Click" Background="#FF9800" Foreground="#111113"/>
                            <Button x:Name="BtnImportFlow" Content="📥 Import Text/File" Click="BtnImportFlow_Click" Background="#2A2A30"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRebrainstorm" Content="⚡ Re-Brainstorm AI Shots" Click="BtnRebrainstorm_Click" Background="#2A2A30" Foreground="#E4E4E7" ToolTip="Clear AI pool and brainstorm with updated brief" Height="32"/>
                    <Button x:Name="BtnSaveClose" Content="✓ Save &amp; Close" Click="BtnSaveClose_Click" Background="#00C853" Foreground="White" FontWeight="Bold" Height="32" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

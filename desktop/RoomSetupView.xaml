<UserControl x:Class="Desktop.RoomSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141416"
             Foreground="#E4E4E7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="PRODUCTION ROOM SETUP" FontSize="14" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center"/>
            <Border Background="#2A2A30" CornerRadius="3" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ATEM SWITCHER ACTIVE" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ROOM CONFIGURATION -->
            <Border Grid.Column="0" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="6" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="CONFIGURATION &amp; CREDENTIALS" Foreground="#FF9800" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock Text="PRODUCTION NAME" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtProductionName" Height="34" Background="#222226" Foreground="#E4E4E7" BorderBrush="#3D3D44" Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="DIRECTOR NAME" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtDirectorName" Height="34" Background="#222226" Foreground="#E4E4E7" BorderBrush="#3D3D44" Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="NETWORK MODE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbNetworkMode" Height="34" Background="#222226" Foreground="#E4E4E7" BorderBrush="#3D3D44" Margin="0,0,0,16" SelectedIndex="1" SelectionChanged="CmbNetworkMode_SelectionChanged">
                        <ComboBoxItem Content="LAN Mode (Local Network Only)"/>
                        <ComboBoxItem Content="Online Mode (Cloud Relay)"/>
                    </ComboBox>

                    <!-- Relay URL field, shown only in Online mode -->
                    <StackPanel x:Name="PnlRelayUrl" Visibility="Visible" Margin="0,0,0,16">
                        <TextBlock Text="RELAY SERVER URL" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRelayUrl" Height="34" Background="#222226" Foreground="#E4E4E7" BorderBrush="#3D3D44" Padding="8,6" Text="wss://vidikom.app/ws/room"/>
                        <TextBlock Text="Crew will connect remotely via vidikom.app" Foreground="#888890" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="INTERCOM CHANNELS" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox Text="PROD (Default Channel)" Height="34" Background="#18181B" Foreground="#71717A" BorderBrush="#2C2C32" Padding="8,6" IsEnabled="False" Margin="0,0,0,24"/>

                    <Button x:Name="BtnCreateRoom" Content="🚀 CREATE PRODUCTION ROOM" Background="#FF9800" Foreground="#111113" FontWeight="Bold" FontSize="11" Height="42" Cursor="Hand" Click="BtnCreateRoom_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- RIGHT: LIVE ROOM STATUS & CREW TOPOLOGY -->
            <Border Grid.Column="1" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="6" Padding="20" Margin="20,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ACTIVE ROOM TOPOLOGY &amp; CREW" Foreground="#FF9800" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Border Background="#141416" Padding="12" Margin="0,0,0,16" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STATUS" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="● ONLINE" Foreground="#00E676" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ACTIVE CREW" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="1 DIRECTOR" Foreground="#E4E4E7" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LATENCY" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="12 ms (LAN)" Foreground="#FF9800" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="CONNECTED CREW MEMBERS" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Director (Host)" Foreground="#E4E4E7" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="MASTER OUT" Foreground="#00E676" FontSize="10" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Border Height="1" Background="#222226" Margin="0,4"/>
                            <Grid Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚪" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Camera 1 Operator" Foreground="#888890" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="Standby" Foreground="#888890" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

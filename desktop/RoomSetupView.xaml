<UserControl x:Class="Desktop.RoomSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B"
             Foreground="#D0D0D0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Room Setup" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Left">
            <TextBlock Text="Production Name" Foreground="#888" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtProductionName" Height="30" Background="#222" Foreground="White" BorderBrush="#444" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Director Name" Foreground="#888" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDirectorName" Height="30" Background="#222" Foreground="White" BorderBrush="#444" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Network Mode" Foreground="#888" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbNetworkMode" Height="30" Background="#222" Foreground="Black" Margin="0,0,0,15" SelectedIndex="0" SelectionChanged="CmbNetworkMode_SelectionChanged">
                <ComboBoxItem Content="LAN Mode (Local Network Only)"/>
                <ComboBoxItem Content="Online Mode (Cloud Relay)"/>
            </ComboBox>

            <!-- Relay URL field, shown only in Online mode -->
            <StackPanel x:Name="PnlRelayUrl" Visibility="Collapsed" Margin="0,0,0,15">
                <TextBlock Text="Relay Server URL" Foreground="#888" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtRelayUrl" Height="30" Background="#222" Foreground="White" BorderBrush="#444" Padding="5" Text="wss://vidikom.app/ws/room"/>
                <TextBlock Text="Crew will connect via vidikom.app" Foreground="#555" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>

            <TextBlock Text="Intercom Channels" Foreground="#888" Margin="0,0,0,5"/>
            <TextBox Text="PROD (Default)" Height="30" Background="#222" Foreground="Gray" BorderBrush="#444" Padding="5" IsEnabled="False" Margin="0,0,0,30"/>

            <Button x:Name="BtnCreateRoom" Content="Create Room" Background="#0078D4" Foreground="White" FontWeight="Bold" FontSize="16" Height="45" Cursor="Hand" Click="BtnCreateRoom_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1084D8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

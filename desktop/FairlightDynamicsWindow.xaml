<Window x:Class="Desktop.FairlightDynamicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop"
        Title="Fairlight Dynamics" SizeToContent="WidthAndHeight"
        MinWidth="600" MinHeight="400"
        Background="#18181B" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#202025" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF9800" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtChannelTag" Text="CAM 1" Foreground="#111" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="FAIRLIGHT DYNAMICS PROCESSOR" Foreground="#AAAAAA" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMasterBypass" Content="DYNAMICS ACTIVE" Background="#888888" Foreground="#111" FontWeight="Bold" FontSize="10" Padding="12,4" Margin="0,0,8,0" Click="BtnMasterBypass_Click" Cursor="Hand" BorderThickness="0"/>
                    <Button Content="RESET DYNAMICS" Background="#33333A" Foreground="#BBB" FontWeight="Bold" FontSize="10" Padding="10,4" Click="BtnResetDyn_Click" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamics Transfer Curve Graph -->
        <Border Grid.Row="1" Background="#101014" BorderBrush="#2A2A35" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" ClipToBounds="True">
            <Grid x:Name="GraphGrid" SizeChanged="GraphGrid_SizeChanged">
                <Canvas x:Name="DynCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" MouseDown="DynCanvas_MouseDown" MouseMove="DynCanvas_MouseMove" MouseUp="DynCanvas_MouseUp"/>
                <!-- Graph Labels -->
                <TextBlock Text="0 dB (Out)" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"/>
                <TextBlock Text="-24 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Text="-60 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,4"/>

                <TextBlock Text="-60 dB (In)" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,4"/>
                <TextBlock Text="-36 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <TextBlock Text="0 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,4"/>
            </Grid>
        </Border>

        <!-- Dynamics Controls (3 Sections: Expander/Gate, Compressor, Limiter) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Expander / Gate -->
            <Border Grid.Column="0" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="EXPANDER / GATE" Foreground="#64FFDA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="ChkGateEnable" Content="Enabled" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,4" Checked="DynControl_Changed" Unchecked="DynControl_Changed"/>

                        <!-- Mode Selector -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <RadioButton x:Name="RadExpanderMode" Content="EXP" Foreground="#AAA" FontSize="9" Margin="0,0,8,0" IsChecked="True" Checked="DynControl_Changed"/>
                            <RadioButton x:Name="RadGateMode" Content="GATE" Foreground="#AAA" FontSize="9" Checked="DynControl_Changed"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                <TextBlock Text="THRESH (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateThresh" Minimum="-60" Maximum="0" Value="-45" Unit="dB" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RANGE (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateRange" Minimum="-60" Maximum="0" Value="-18" Unit="dB" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RATIO" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateRatio" Minimum="1.0" Maximum="10.0" Value="2.0" Unit=":1" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                <TextBlock Text="ATTACK (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateAttack" Minimum="0.5" Maximum="100.0" Value="1.4" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="HOLD (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateHold" Minimum="0" Maximum="4000" Value="50" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RELEASE (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldGateRelease" Minimum="20" Maximum="2000" Value="100" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Compressor -->
            <Border Grid.Column="1" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="COMPRESSOR" Foreground="#AAAAAA" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="ChkCompEnable" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,6" Checked="DynControl_Changed" Unchecked="DynControl_Changed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 1 -->
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="THRESHOLD (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompThresh" Minimum="-60" Maximum="0" Value="-14" Unit="dB" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RATIO" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompRatio" Minimum="1.0" Maximum="20.0" Value="3.0" Unit=":1" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="ATTACK (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompAttack" Minimum="0.5" Maximum="100.0" Value="10.0" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>

                            <!-- Col 2 -->
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="HOLD (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompHold" Minimum="0" Maximum="4000" Value="0" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RELEASE (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompRelease" Minimum="20" Maximum="2000" Value="100" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="MAKEUP GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldCompGain" Minimum="0" Maximum="24" Value="2.0" Unit="dB" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Limiter -->
            <Border Grid.Column="2" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="LIMITER" Foreground="#FF5252" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="ChkLimiterEnable" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,6" Checked="DynControl_Changed" Unchecked="DynControl_Changed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                <TextBlock Text="THRESHOLD (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldLimiterThresh" Minimum="-20" Maximum="0" Value="-2" Unit="dB" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="ATTACK (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldLimiterAttack" Minimum="0.5" Maximum="100.0" Value="1.0" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                <TextBlock Text="HOLD (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldLimiterHold" Minimum="0" Maximum="4000" Value="0" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>

                                <TextBlock Text="RELEASE (ms)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                                <local:KnobControl x:Name="SldLimiterRelease" Minimum="10" Maximum="1000" Value="50" Unit="ms" ValueChanged="DynKnob_Changed" Margin="0,1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="APPLY &amp; CLOSE" Background="#AAAAAA" Foreground="#111" FontWeight="Bold" FontSize="11" Padding="18,6" Click="BtnApplyClose_Click" Cursor="Hand" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>


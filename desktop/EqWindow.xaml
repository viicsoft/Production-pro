<Window x:Class="Desktop.EqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equalizer" Height="650" Width="950" Background="#1D1D1D"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Top Visualizer -->
        <Border Grid.Row="0" Background="#242424" Margin="10" BorderBrush="#333333" BorderThickness="1">
            <Canvas x:Name="EqCanvas" SizeChanged="EqCanvas_SizeChanged" Background="Transparent">
                <!-- Grid Lines will be drawn in code-behind -->
                <Path x:Name="EqFillPath" Fill="#3300BCD4" Stroke="Transparent" />
                <Path x:Name="EqStrokePath" Stroke="#00BCD4" StrokeThickness="2" />
                <!-- Draggable Band Points will be added here -->
            </Canvas>
        </Border>
        
        <!-- Bottom Bands -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,10,10">
            <!-- Band 1 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 1" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B1Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B1Freq" Text="46" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B1Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B1Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
            <!-- Band 2 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 2" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B2Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B2Freq" Text="90" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B2Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B2Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
            <!-- Band 3 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 3" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B3Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B3Freq" Text="300" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B3Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B3Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
            <!-- Band 4 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 4" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B4Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B4Freq" Text="1000" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B4Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B4Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
            <!-- Band 5 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,5,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 5" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B5Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B5Freq" Text="5000" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B5Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B5Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
            <!-- Band 6 -->
            <Border Width="140" Background="#222222" BorderBrush="#111111" BorderThickness="1" Margin="0,0,0,0" CornerRadius="5">
                <StackPanel Margin="10">
                    <TextBlock Text="Band 6" Foreground="#00BCD4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <CheckBox x:Name="B6Enabled" Content="Enabled" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" Click="BandControl_Changed" />
                    <TextBlock Text="Frequency" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B6Freq" Text="12000" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Gain" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B6Gain" Text="+0.0" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,10" TextChanged="BandControl_Changed" />
                    <TextBlock Text="Q Factor" Foreground="Gray" HorizontalAlignment="Center" FontSize="11" />
                    <TextBox x:Name="B6Q" Text="2.3" Background="#111" Foreground="White" BorderThickness="0" TextAlignment="Center" Width="60" Margin="0,2,0,5" TextChanged="BandControl_Changed" />
                </StackPanel>
            </Border>
            
        </StackPanel>
    </Grid>
</Window>



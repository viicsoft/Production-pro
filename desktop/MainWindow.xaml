<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vidikom Atem Software Control"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1B"
        Foreground="#D0D0D0"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ================= COLORS ================= -->
        <!-- SLEEK BUTTON STYLE -->
        <Style x:Key="SleekButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- SLEEK TOGGLE BUTTON STYLE -->
        <Style x:Key="SleekToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- POPUP MENU BUTTON STYLE -->
        <Style x:Key="PopupMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="WindowBg" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#282828"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="TextNormal" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#999999"/>

        <!-- ================= PULSING GLOW STORYBOARD ================= -->
        <Storyboard x:Key="ProgramPulse" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                From="12" To="30" Duration="0:0:0.6" AutoReverse="True"
                EasingFunction="{x:Null}"/>
        </Storyboard>

        <!-- ================= NEUTRAL (UNLIT FROSTED SILVER-WHITE) BLACKMAGIC 3D GLASS BUTTON ================= -->
        <Style x:Key="NeutralCamButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="#141518"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 1. Deep Recessed Black Panel Socket -->
                        <Border x:Name="OuterSocket" CornerRadius="14" Background="#050507" BorderBrush="#000000" BorderThickness="2.5" Padding="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.9"/>
                            </Border.Effect>

                            <!-- 2. Thick Molded Clear Glass Shell (Dark Glass Wall + Specular Corner Caustics) -->
                            <Border x:Name="GlassShell" CornerRadius="11.5" BorderThickness="1.8" ClipToBounds="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E8ECF2" Offset="0.0"/>
                                        <GradientStop Color="#7A7E88" Offset="0.3"/>
                                        <GradientStop Color="#484B52" Offset="0.7"/>
                                        <GradientStop Color="#C4C8D2" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <!-- Dark translucent glass wall thickness -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4A4E56" Offset="0.0"/>
                                        <GradientStop Color="#222428" Offset="0.22"/>
                                        <GradientStop Color="#383B42" Offset="0.50"/>
                                        <GradientStop Color="#1C1E22" Offset="0.78"/>
                                        <GradientStop Color="#42464E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <!-- Molded Glass Wall Corner Specular Caustics (4 curved glass wall reflections) -->
                                    <Border CornerRadius="10" Margin="2" BorderThickness="2" Opacity="0.75" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F0F4FA" Offset="0.0"/>
                                                <GradientStop Color="#20FFFFFF" Offset="0.20"/>
                                                <GradientStop Color="#90D8DCE4" Offset="0.50"/>
                                                <GradientStop Color="#20FFFFFF" Offset="0.80"/>
                                                <GradientStop Color="#E8ECF4" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>

                                    <!-- Outer Concentric Glass Refraction Rings (extend into the glass bevel corners like real ATEM caps) -->
                                    <Viewbox Stretch="Uniform" Margin="-10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Grid Width="140" Height="140">
                                            <Ellipse StrokeThickness="3" Opacity="0.42">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#30FFFFFF" Offset="0.35"/>
                                                        <GradientStop Color="#40000000" Offset="0.65"/>
                                                        <GradientStop Color="#E0FFFFFF" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                            <Ellipse Margin="6" StrokeThickness="2" Opacity="0.35">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                                        <GradientStop Color="#D0FFFFFF" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                        </Grid>
                                    </Viewbox>

                                    <!-- 3. Inner Frosted Diffuser Square Cap -->
                                    <Border x:Name="InnerDiffuser" Margin="9" CornerRadius="7" BorderThickness="1.5" ClipToBounds="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8A8E96" Offset="0.0"/>
                                                <GradientStop Color="#D4D8E0" Offset="0.5"/>
                                                <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <!-- Soft pillowy radial diffuser (bright center, shaded corners) -->
                                            <RadialGradientBrush Center="0.52,0.52" GradientOrigin="0.56,0.56" RadiusX="0.72" RadiusY="0.72">
                                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#F0F2F6" Offset="0.45"/>
                                                <GradientStop Color="#D5D9E2" Offset="0.78"/>
                                                <GradientStop Color="#B2B7C2" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Border.Background>

                                        <Grid>
                                            <!-- 4. Translucent Concave Optical Glass Dish (blended refraction, NO opaque ring) -->
                                            <Viewbox Stretch="Uniform" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Grid Width="120" Height="120">
                                                    <!-- Soft outer shadow/highlight transition of the concave lens -->
                                                    <Ellipse Margin="-2" StrokeThickness="3.5" Opacity="0.45">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#55000000" Offset="0.0"/>
                                                                <GradientStop Color="#08000000" Offset="0.42"/>
                                                                <GradientStop Color="#30FFFFFF" Offset="0.58"/>
                                                                <GradientStop Color="#EEFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#24000000" Offset="0.0"/>
                                                                <GradientStop Color="#00000000" Offset="0.45"/>
                                                                <GradientStop Color="#18FFFFFF" Offset="0.70"/>
                                                                <GradientStop Color="#55FFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <!-- Inner crisp glass refraction crescent -->
                                                    <Ellipse Margin="1.5" StrokeThickness="1.2" Opacity="0.65">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                                                                <GradientStop Color="Transparent" Offset="0.35"/>
                                                                <GradientStop Color="Transparent" Offset="0.65"/>
                                                                <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                    </Ellipse>
                                                </Grid>
                                            </Viewbox>

                                            <!-- 5. Curved Convex Glass Surface Reflection (Soft Arc, no flat horizontal line) -->
                                            <Grid IsHitTestVisible="False" ClipToBounds="True">
                                                <Ellipse Width="360" Height="190" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-60,-105,-60,0" Opacity="0.52">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.6,1">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                            <GradientStop Color="#88FFFFFF" Offset="0.55"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <!-- 6. Engraved Silkscreen Broadcast Legend -->
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4">
                                                <ContentPresenter.Effect>
                                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="1" ShadowDepth="1" Direction="315" Opacity="0.65"/>
                                                </ContentPresenter.Effect>
                                            </ContentPresenter>
                                        </Grid>
                                    </Border>

                                    <!-- 7. Top-Right Diagonal Glass Surface Specular Glint & Inner Glass Rim -->
                                    <Border CornerRadius="10" Margin="1" BorderThickness="1" IsHitTestVisible="False" Opacity="0.55">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#90FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterSocket" Property="BorderBrush" Value="#2E323B"/>
                                <Setter TargetName="GlassShell" Property="Opacity" Value="0.97"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerDiffuser" Property="Margin" Value="10"/>
                                <Setter TargetName="InnerDiffuser" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= PREVIEW (ILLUMINATED GREEN) BLACKMAGIC 3D GLASS BUTTON ================= -->
        <Style x:Key="PreviewCamButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="#0D140E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 1. Deep Recessed Panel Socket with Green LED Bleed -->
                        <Border x:Name="OuterSocket" CornerRadius="14" Background="#041407" BorderBrush="#0A2810" BorderThickness="2.5" Padding="2">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E640" BlurRadius="16" ShadowDepth="0" Opacity="0.65"/>
                            </Border.Effect>

                            <!-- 2. Thick Molded Clear Glass Shell over Green LED -->
                            <Border x:Name="GlassShell" CornerRadius="11.5" BorderThickness="1.8" ClipToBounds="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#B8FFC4" Offset="0.0"/>
                                        <GradientStop Color="#249E38" Offset="0.3"/>
                                        <GradientStop Color="#0D4E18" Offset="0.7"/>
                                        <GradientStop Color="#7AFF92" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <!-- Dark emerald translucent glass wall thickness -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E7A2C" Offset="0.0"/>
                                        <GradientStop Color="#093010" Offset="0.22"/>
                                        <GradientStop Color="#145820" Offset="0.50"/>
                                        <GradientStop Color="#06240B" Offset="0.78"/>
                                        <GradientStop Color="#1B6E28" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <!-- Molded Glass Wall Corner Specular Caustics -->
                                    <Border CornerRadius="10" Margin="2" BorderThickness="2" Opacity="0.7" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#D0FFD8" Offset="0.0"/>
                                                <GradientStop Color="#2040FF60" Offset="0.20"/>
                                                <GradientStop Color="#8038E050" Offset="0.50"/>
                                                <GradientStop Color="#2040FF60" Offset="0.80"/>
                                                <GradientStop Color="#B8FFC4" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>

                                    <!-- Outer Concentric Glass Refraction Rings -->
                                    <Viewbox Stretch="Uniform" Margin="-10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Grid Width="140" Height="140">
                                            <Ellipse StrokeThickness="3" Opacity="0.38">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#C8FFD0" Offset="0.0"/>
                                                        <GradientStop Color="#20FFFFFF" Offset="0.35"/>
                                                        <GradientStop Color="#40000000" Offset="0.65"/>
                                                        <GradientStop Color="#B0FFC0" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                            <Ellipse Margin="6" StrokeThickness="2" Opacity="0.3">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                        <GradientStop Color="#D8FFE0" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                                        <GradientStop Color="#A8FFB8" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                        </Grid>
                                    </Viewbox>

                                    <!-- 3. Inner Glowing Green Diffuser Square Cap -->
                                    <Border x:Name="InnerDiffuser" Margin="9" CornerRadius="7" BorderThickness="1.5" ClipToBounds="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0D6E1C" Offset="0.0"/>
                                                <GradientStop Color="#38EC52" Offset="0.5"/>
                                                <GradientStop Color="#B8FFC4" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <!-- Glowing green LED radial diffuser (hot lime center, rich emerald corners) -->
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.48" RadiusX="0.70" RadiusY="0.70">
                                                <GradientStop Color="#98FF72" Offset="0.0"/>
                                                <GradientStop Color="#35F24B" Offset="0.38"/>
                                                <GradientStop Color="#06CE26" Offset="0.75"/>
                                                <GradientStop Color="#008816" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Border.Background>

                                        <Grid>
                                            <!-- 4. Translucent Concave Optical Glass Dish -->
                                            <Viewbox Stretch="Uniform" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Grid Width="120" Height="120">
                                                    <Ellipse Margin="-2" StrokeThickness="3.5" Opacity="0.38">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#66003808" Offset="0.0"/>
                                                                <GradientStop Color="#08000000" Offset="0.42"/>
                                                                <GradientStop Color="#35FFFFFF" Offset="0.58"/>
                                                                <GradientStop Color="#DDFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#22003006" Offset="0.0"/>
                                                                <GradientStop Color="#00000000" Offset="0.45"/>
                                                                <GradientStop Color="#15FFFFFF" Offset="0.70"/>
                                                                <GradientStop Color="#45FFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Margin="1.5" StrokeThickness="1.2" Opacity="0.55">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#70FFFFFF" Offset="0.0"/>
                                                                <GradientStop Color="Transparent" Offset="0.35"/>
                                                                <GradientStop Color="Transparent" Offset="0.65"/>
                                                                <GradientStop Color="#EEFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                    </Ellipse>
                                                </Grid>
                                            </Viewbox>

                                            <!-- 5. Curved Convex Glass Surface Reflection -->
                                            <Grid IsHitTestVisible="False" ClipToBounds="True">
                                                <Ellipse Width="360" Height="190" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-60,-105,-60,0" Opacity="0.42">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.6,1">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                            <GradientStop Color="#75FFFFFF" Offset="0.55"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <!-- 6. Engraved Silkscreen Broadcast Legend -->
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4">
                                                <ContentPresenter.Effect>
                                                    <DropShadowEffect Color="#A8FFB2" BlurRadius="1" ShadowDepth="1" Direction="315" Opacity="0.5"/>
                                                </ContentPresenter.Effect>
                                            </ContentPresenter>
                                        </Grid>
                                    </Border>

                                    <!-- 7. Outer Glass Inner-Edge Specular Rim -->
                                    <Border CornerRadius="10" Margin="1" BorderThickness="1" IsHitTestVisible="False" Opacity="0.5">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#80FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerDiffuser" Property="Margin" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= PROGRAM (ILLUMINATED RED) BLACKMAGIC 3D GLASS BUTTON ================= -->
        <Style x:Key="ProgramCamButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="#140606"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 1. Deep Recessed Panel Socket with Red LED Bleed -->
                        <Border x:Name="OuterSocket" CornerRadius="14" Background="#1C0404" BorderBrush="#380808" BorderThickness="2.5" Padding="2">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ProgramGlow" Color="#FF1A1A" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
                            </Border.Effect>

                            <!-- 2. Thick Molded Clear Glass Shell over Red LED -->
                            <Border x:Name="GlassShell" CornerRadius="11.5" BorderThickness="1.8" ClipToBounds="True">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB4AA" Offset="0.0"/>
                                        <GradientStop Color="#B82424" Offset="0.3"/>
                                        <GradientStop Color="#580808" Offset="0.7"/>
                                        <GradientStop Color="#FF857A" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <!-- Dark ruby translucent glass wall thickness -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8E1A1A" Offset="0.0"/>
                                        <GradientStop Color="#380606" Offset="0.22"/>
                                        <GradientStop Color="#681010" Offset="0.50"/>
                                        <GradientStop Color="#2B0404" Offset="0.78"/>
                                        <GradientStop Color="#7E1616" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Grid>
                                    <!-- Molded Glass Wall Corner Specular Caustics -->
                                    <Border CornerRadius="10" Margin="2" BorderThickness="2" Opacity="0.72" IsHitTestVisible="False">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFD0C8" Offset="0.0"/>
                                                <GradientStop Color="#25FF6060" Offset="0.20"/>
                                                <GradientStop Color="#85F04040" Offset="0.50"/>
                                                <GradientStop Color="#25FF6060" Offset="0.80"/>
                                                <GradientStop Color="#FFB8B0" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>

                                    <!-- Outer Concentric Glass Refraction Rings (matches reference image corner arcs) -->
                                    <Viewbox Stretch="Uniform" Margin="-10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Grid Width="140" Height="140">
                                            <Ellipse StrokeThickness="3" Opacity="0.40">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFD2C8" Offset="0.0"/>
                                                        <GradientStop Color="#20FFFFFF" Offset="0.35"/>
                                                        <GradientStop Color="#45000000" Offset="0.65"/>
                                                        <GradientStop Color="#FFB8AE" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                            <Ellipse Margin="6" StrokeThickness="2" Opacity="0.32">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFE0D8" Offset="0.0"/>
                                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                                        <GradientStop Color="#FFA89E" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                        </Grid>
                                    </Viewbox>

                                    <!-- 3. Inner Glowing Red-Orange Diffuser Square Cap -->
                                    <Border x:Name="InnerDiffuser" Margin="9" CornerRadius="7" BorderThickness="1.5" ClipToBounds="True">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#800808" Offset="0.0"/>
                                                <GradientStop Color="#FF3828" Offset="0.5"/>
                                                <GradientStop Color="#FFB2A6" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <Border.Background>
                                            <!-- Glowing Red-Orange LED radial diffuser (fiery orange-red center, deep crimson corners) -->
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.48" RadiusX="0.70" RadiusY="0.70">
                                                <GradientStop Color="#FF683B" Offset="0.0"/>
                                                <GradientStop Color="#FF2814" Offset="0.40"/>
                                                <GradientStop Color="#EB0404" Offset="0.76"/>
                                                <GradientStop Color="#B20000" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Border.Background>

                                        <Grid>
                                            <!-- 4. Translucent Concave Optical Glass Dish -->
                                            <Viewbox Stretch="Uniform" Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Grid Width="120" Height="120">
                                                    <Ellipse Margin="-2" StrokeThickness="3.5" Opacity="0.38">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#66380000" Offset="0.0"/>
                                                                <GradientStop Color="#08000000" Offset="0.42"/>
                                                                <GradientStop Color="#35FFFFFF" Offset="0.58"/>
                                                                <GradientStop Color="#DDFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#24380000" Offset="0.0"/>
                                                                <GradientStop Color="#00000000" Offset="0.45"/>
                                                                <GradientStop Color="#15FFFFFF" Offset="0.70"/>
                                                                <GradientStop Color="#45FFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Margin="1.5" StrokeThickness="1.2" Opacity="0.55">
                                                        <Ellipse.Stroke>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#70FFFFFF" Offset="0.0"/>
                                                                <GradientStop Color="Transparent" Offset="0.35"/>
                                                                <GradientStop Color="Transparent" Offset="0.65"/>
                                                                <GradientStop Color="#EEFFFFFF" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Stroke>
                                                    </Ellipse>
                                                </Grid>
                                            </Viewbox>

                                            <!-- 5. Curved Convex Glass Surface Reflection -->
                                            <Grid IsHitTestVisible="False" ClipToBounds="True">
                                                <Ellipse Width="360" Height="190" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-60,-105,-60,0" Opacity="0.40">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.6,1">
                                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                            <GradientStop Color="#75FFFFFF" Offset="0.55"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <!-- 6. Engraved Silkscreen Broadcast Legend -->
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4">
                                                <ContentPresenter.Effect>
                                                    <DropShadowEffect Color="#FF9A88" BlurRadius="1" ShadowDepth="1" Direction="315" Opacity="0.45"/>
                                                </ContentPresenter.Effect>
                                            </ContentPresenter>
                                        </Grid>
                                    </Border>

                                    <!-- 7. Outer Glass Inner-Edge Specular Rim -->
                                    <Border CornerRadius="10" Margin="1" BorderThickness="1" IsHitTestVisible="False" Opacity="0.5">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#80FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerDiffuser" Property="Margin" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


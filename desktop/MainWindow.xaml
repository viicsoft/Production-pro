                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#555564"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Chevron" Property="Stroke" Value="#FF9800"/>

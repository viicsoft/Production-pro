                    <MenuItem Header="Show Stream View" x:Name="MenuShowStreamView" Click="MenuShowStreamView_Click"/>
                    <MenuItem Header="Start Streaming" x:Name="MenuStartStreaming" Click="MenuStartStreaming_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Stop Streaming" x:Name="MenuStopStreaming" Click="MenuStopStreaming_Click" IsEnabled="False"/>
                    <MenuItem Header="Stream Settings..." x:Name="MenuStreamSettings" Click="MenuStreamSettings_Click"/>
                </MenuItem>
                <MenuItem Header="Record">
                    <MenuItem Header="Show Record View" x:Name="MenuShowRecordView" Click="MenuShowRecordView_Click"/>
                    <MenuItem Header="Start Recording" x:Name="MenuStartRecording" Click="MenuStartRecording_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Stop Recording" x:Name="MenuStopRecording" Click="MenuStopRecording_Click" IsEnabled="False"/>
                    <MenuItem Header="Switch Active Disk" x:Name="MenuSwitchActiveDisk" Click="MenuSwitchActiveDisk_Click"/>
                    <MenuItem Header="Record Settings &amp; ISO..." x:Name="MenuRecordSettings" Click="MenuRecordSettings_Click"/>
                </MenuItem>
                <MenuItem Header="AI Director">
                    <MenuItem Header="Production Briefing" x:Name="MenuProductionBriefing" Click="MenuProductionBriefing_Click"/>
                    <MenuItem Header="Start AI Director" x:Name="MenuStartAiDirector" Click="StartAiDirector_Click"/>
                    <MenuItem Header="Stop AI Director" x:Name="MenuStopAiDirector" Click="StopAiDirector_Click" IsEnabled="False"/>
                    <MenuItem Header="Mode: Brainstorm" x:Name="MenuAiMode" Click="MenuAiMode_Click"/>
                    <MenuItem Header="Start Autonomous Switching" x:Name="MenuStartAutonomous" Click="StartAutonomous_Click"/>
                    <MenuItem Header="Stop Autonomous Switching" x:Name="MenuStopAutonomous" Click="StopAutonomous_Click" IsEnabled="False"/>
                    <MenuItem Header="Pause (Take the wheel)" x:Name="MenuPauseAiDirector" Click="PauseAiDirector_Click" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Connection">
                    <MenuItem Header="Show Connection View" x:Name="MenuShowConnectionView" Click="MenuShowConnectionView_Click"/>
                    <MenuItem Header="Link to Remote PC Switcher (PIN)..." x:Name="MenuLinkRemotePin" Click="MenuLinkRemotePin_Click" FontWeight="SemiBold" Foreground="#FF9800"/>
                    <MenuItem Header="Connect" x:Name="MenuConnect" Click="Connect_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Disconnect" x:Name="MenuDisconnect" Click="Disconnect_Click" IsEnabled="False"/>
                    <MenuItem Header="Host Settings" x:Name="MenuHostSettings" StaysOpenOnClick="True">
                        <MenuItem.Icon>
                            <Border Background="#2A2216" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="IP" FontSize="9" FontWeight="Bold" Foreground="#FF9800"/>
                            </Border>
                        </MenuItem.Icon>
                        <MenuItem Style="{StaticResource MenuCardItemStyle}">
                            <MenuItem.Header>
                                <Border Background="#15151A" BorderBrush="#2E2E3A" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                    <StackPanel Width="210">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="SWITCHER HOST / IP" FontSize="10" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center"/>
                                            <Border Background="#1B2A1E" BorderBrush="#2E5434" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                <TextBlock Text="USB / LAN" FontSize="9" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                            </Border>
                                        </Grid>
                                        <TextBox x:Name="Host"
                                                 Text="AUTO"
                                                 Background="#0E0E12"
                                                 Foreground="#FFFFFF"
                                                 CaretBrush="#FF9800"
                                                 BorderBrush="#3A3A48"
                                                 BorderThickness="1"
                                                 Padding="8,5"
                                                 FontFamily="Consolas, Segoe UI"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Edit Inputs..." Click="ToggleEditMode_Click"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About Vidikom..." x:Name="MenuAbout" Click="MenuAbout_Click" FontWeight="SemiBold"/>
                    <MenuItem Header="Device Information..." x:Name="MenuDeviceInfo" Click="MenuDeviceInfo_Click"/>
                    <MenuItem Header="Keyboard Shortcuts..." x:Name="MenuKeyboardShortcuts" Click="MenuKeyboardShortcuts_Click" InputGestureText="F1"/>
                    <MenuItem Header="Diagnostics..." x:Name="MenuDiagnostics" Click="MenuDiagnostics_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 2. HEADER -->
        <Grid Grid.Row="1" Background="{StaticResource PanelBg}" Height="50">
            <!-- DEFAULT HEADER -->
            <Grid x:Name="EmptyRoomHeader" Visibility="Visible">
                <TextBlock Text="Vidikom Atem Software Control" 
                           Foreground="#888" 
                           FontSize="22" 
                           FontWeight="Light" 
                           VerticalAlignment="Center" 
                           Margin="20,0"/>
            </Grid>

            <!-- ACTIVE ROOM HEADER -->
            <Grid x:Name="ActiveRoomHeader" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Vidikom Atem Software Control"
                               Foreground="#888"
                               FontSize="22"
                               FontWeight="Light"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <TextBlock x:Name="TxtHeaderRoomId" Text="123 456" Visibility="Collapsed"/>

                    <Border Background="#221E18" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Share this 4-digit PIN with other computers on the network to control this switcher">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PIN:" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtHeaderPin" Text="9999" Foreground="#FF9800" FontSize="13" FontWeight="Black" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtCrewCount" Text="Crew: 0" Foreground="#AAA" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtNetworkMode" Text="" Foreground="#4CAF50" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold"/>

                    <Border x:Name="SegmentTracker" Background="#333" CornerRadius="4" Padding="5,2" Visibility="Collapsed" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOW:" Foreground="#FF8C00" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtCurrentSegment" Text="Welcome" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnNextSegment" Content="Next &#x25B6;" FontSize="10" Padding="5,0" Background="#444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnNextSegment_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <!-- LINK PC BY PIN POPUP -->
                <Grid Margin="0,0,10,0">
                    <ToggleButton x:Name="BtnLinkRemotePin" Content="LINK PC (PIN)" Style="{StaticResource SleekToggleButton}" Checked="BtnLinkRemotePin_Checked" ToolTip="Connect and control another Vidikom switcher on the same network or internet using its 4-digit PIN"/>
                    <Popup x:Name="PopupLinkRemotePin" IsOpen="{Binding IsChecked, ElementName=BtnLinkRemotePin}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnLinkRemotePin}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True">
                        <Border Background="#1C1C22" BorderBrush="#FF9800" BorderThickness="1.2" CornerRadius="6" Padding="14,12" Width="300">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.65" ShadowDepth="4" Direction="270" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="MULTI-PC SWITCHER LINK (PIN)" Foreground="#FF9800" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Border Background="#131317" BorderBrush="#2D2D36" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="THIS PC HOST PIN" Foreground="#888894" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtPopupLocalPin" Text="9999" Foreground="#00E676" FontSize="16" FontWeight="Black" FontFamily="Consolas, Segoe UI"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="LAN ENDPOINT" Foreground="#888894" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtPopupLocalIp" Text="127.0.0.1:8080" Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="ENTER REMOTE SWITCHER 4-DIGIT PIN" Foreground="#B4B4BE" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRemotePinInput"
                                         MaxLength="8"
                                         Height="32"
                                         Background="#0E0E12"
                                         Foreground="#FFFFFF"
                                         CaretBrush="#FF9800"
                                         BorderBrush="#3A3A48"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         FontFamily="Consolas, Segoe UI"
                                         FontSize="15"
                                         FontWeight="Bold"
                                         Margin="0,0,0,8"
                                         ToolTip="Enter the 4-digit PIN displayed on the primary Vidikom computer"/>

                                <TextBlock Text="HOST IP OR ROOM ID (OPTIONAL - AUTO DISCOVERS)" Foreground="#888894" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRemoteHostHintInput"
                                         Height="28"
                                         Background="#0E0E12"
                                         Foreground="#CCCCCC"
                                         CaretBrush="#FF9800"
                                         BorderBrush="#2E2E3A"
                                         BorderThickness="1"
                                         Padding="8,4"
                                         FontFamily="Consolas, Segoe UI"
                                         FontSize="11"
                                         Margin="0,0,0,10"
                                         ToolTip="Leave blank for automatic LAN + Cloud Relay discovery by PIN, or enter Host IP (e.g. 192.168.1.50)"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnConnectRemotePin"
                                            Grid.Column="0"
                                            Content="CONNECT BY PIN"
                                            Background="#FF9800"
                                            Foreground="#111113"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Height="32"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="BtnConnectRemotePin_Click"/>
                                    <Button x:Name="BtnDisconnectRemotePin"
                                            Grid.Column="1"
                                            Content="UNLINK"
                                            Background="#D32F2F"
                                            Foreground="#FFFFFF"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Height="32"
                                            Padding="10,0"
                                            Margin="6,0,0,0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="BtnDisconnectRemotePin_Click"/>
                                </Grid>

                                <TextBlock x:Name="TxtRemotePinStatus"
                                           Text="Ready to link via LAN or Cloud Relay."
                                           Foreground="#9E9EA8"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Margin="0,0,15,0">
                    <ToggleButton x:Name="BtnRoomOptionsMenu" Content="Room Options" Style="{StaticResource SleekToggleButton}" Visibility="Collapsed" />
                    <Popup IsOpen="{Binding IsChecked, ElementName=BtnRoomOptionsMenu}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnRoomOptionsMenu}" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True">
                        <Border Background="#2B2B2B" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="0,5" MinWidth="150">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="3" Direction="270" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button x:Name="BtnShowQr" Content="Show QR Code" Click="BtnShowQr_Click" Style="{StaticResource PopupMenuButton}"/>
                                <Button x:Name="BtnCopyLink" Content="Copy Link" Click="BtnCopyLink_Click" Style="{StaticResource PopupMenuButton}"/>
                                <Button x:Name="BtnToggleMicMute" Content="MIC: LIVE" Background="#2E7D32" Foreground="White" Click="BtnToggleMicMute_Click" ToolTip="Mute or Unmute Director Microphone" Style="{StaticResource PopupMenuButton}"/>
                                <Button x:Name="BtnToggleIntercom" Content="INTERCOM: OFF" Background="#333" Foreground="#AAA" Click="BtnToggleIntercom_Click" ToolTip="Toggle Director Voice Intercom" Style="{StaticResource PopupMenuButton}"/>
                                <Button x:Name="BtnRegenPin" Content="Regen PIN" Click="BtnRegenPin_Click" Foreground="#4DA8DA" Style="{StaticResource PopupMenuButton}"/>
                                <Button x:Name="BtnEndRoom" Content="End Room" Click="BtnEndRoom_Click" Foreground="#FF5555" Style="{StaticResource PopupMenuButton}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Image Source="pack://application:,,,/icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Vidikom" Foreground="White" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN BODY: CAMERA BUTTON GRID + T-BAR -->
        <Grid x:Name="PanelSwitcher" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Camera buttons -->
                <ColumnDefinition Width="100"/>    <!-- T-Bar fader -->
            </Grid.ColumnDefinitions>

            <!-- Camera Button Grid -->
            <Grid x:Name="ButtonGrid" Grid.Column="0" Margin="10"
                  SizeChanged="ButtonGrid_SizeChanged"/>

            <!-- T-BAR FADER -->
            <Border Grid.Column="1" Background="#161616" CornerRadius="8" Margin="4,10,10,10"
                    BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- T-Bar Label -->
                    <TextBlock Text="T-BAR" HorizontalAlignment="Center" 
                               Foreground="#555" FontSize="10" FontWeight="Bold"
                               Margin="0,8,0,4"/>

                    <!-- Fader Track Area -->
                    <Border Grid.Row="1" Background="#111" CornerRadius="6" Margin="10,4,10,14" BorderBrush="#0A0A0A" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" Direction="90" Color="#222" Opacity="0.5" BlurRadius="2"/>
                        </Border.Effect>
                        <Canvas x:Name="TBarCanvas"
                                Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="TBarCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="TBarCanvas_MouseLeftButtonUp"
                                MouseMove="TBarCanvas_MouseMove" Cursor="Hand">

                            <!-- Track line (deep groove) -->
                            <Border x:Name="TBarTrackLine" Width="6" Background="#000" CornerRadius="3" Canvas.Left="30">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" Color="#222" Opacity="0.3" BlurRadius="2"/>
                                </Border.Effect>
                            </Border>

                            <!-- Handle -->
                            <Border x:Name="TBarHandle" Width="66" Height="26" CornerRadius="13"
                                    Cursor="Hand" Canvas.Left="0" Canvas.Top="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#C5C5C5" Offset="0.2"/>
                                        <GradientStop Color="#A0A0A0" Offset="0.5"/>
                                        <GradientStop Color="#707070" Offset="0.8"/>
                                        <GradientStop Color="#AAAAAA" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="4" Opacity="0.8" Direction="270"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Central black divider -->
                                    <Rectangle Width="3" Height="26" Fill="#0A0A0A" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ALTERNATIVE VIEWS -->

        <!-- MEDIA POOL -->
        <ContentControl x:Name="PanelMedia" Grid.Row="2" Visibility="Collapsed"/>

        <!-- AUDIO MIXER -->
        <ContentControl x:Name="PanelAudio" Grid.Row="2" Visibility="Collapsed"/>
          <ContentControl x:Name="PanelAfvGroups" Grid.Row="2" Visibility="Collapsed"/>

        <!-- CAMERA CONTROL -->
        <ContentControl x:Name="PanelCamera" Grid.Row="2" Visibility="Collapsed"/>

        <!-- SHOT SUGGESTIONS -->
        <ContentControl x:Name="PanelShotSuggestions" Grid.Row="2" Visibility="Collapsed"/>

        <!-- ROOM SETUP -->
        <ContentControl x:Name="PanelRoomSetup" Grid.Row="2" Visibility="Collapsed"/>

        <!-- CONNECTION -->
        <ContentControl x:Name="PanelConnection" Grid.Row="2" Visibility="Collapsed"/>

        <!-- STREAM -->
        <ContentControl x:Name="PanelStream" Grid.Row="2" Visibility="Collapsed"/>

        <!-- RECORD -->
        <ContentControl x:Name="PanelRecord" Grid.Row="2" Visibility="Collapsed"/>

        <!-- MACROS -->
        <ContentControl x:Name="PanelMacros" Grid.Row="2" Visibility="Collapsed"/>

        <!-- OUTPUTS -->
        <ContentControl x:Name="PanelOutputs" Grid.Row="2" Visibility="Collapsed"/>

        <!-- 4. TRANSITION BUTTON BAR -->
        <Border x:Name="TransitionButtonBar" Grid.Row="3" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><RepeatButton x:Name="BtnScrollLeft" Grid.Column="0"  Foreground="#888" Background="Transparent" BorderThickness="0" Padding="8,0" Click="BtnScrollLeft_Click" VerticalAlignment="Stretch" Visibility="Collapsed" Cursor="Hand" ><Path Data="M 6,0 L 0,5 L 6,10" Stroke="#888" StrokeThickness="2" VerticalAlignment="Center" Fill="Transparent"/></RepeatButton><ScrollViewer x:Name="BottomBarScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="BottomBarScroll_ScrollChanged"
                          PanningMode="HorizontalOnly" PreviewMouseWheel="BottomBarScroll_PreviewMouseWheel" Padding="10,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    
                    <!-- Smart Grouped View Tabs -->
                    <Button x:Name="TabSwitcher" Content="SWITCHER" Style="{StaticResource ViewTabButtonSelected}" Click="ViewTab_Click" Tag="Switcher"/>
                    <Button x:Name="TabMedia" Content="MEDIA" Style="{StaticResource ViewTabButton}" Click="ViewTab_Click" Tag="Media"/>

                    <!-- AUDIO GROUP (Audio Mixer + AFV Groups) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupTabAudio" Content="AUDIO" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupTabAudio}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupTabAudio}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="6" Margin="8" MinWidth="170">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="AUDIO WORKSPACE" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="8,2,8,4"/>
                                    <Button x:Name="TabAudio" Content="AUDIO MIXER" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Audio"/>
                                    <Button x:Name="TabAfvGroups" Content="AFV GROUPS" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="AfvGroups"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="TabCamera" Content="CAMERA" Style="{StaticResource ViewTabButton}" Click="ViewTab_Click" Tag="Camera"/>

                    <!-- STUDIO & AI GROUP (Room, Shot Suggestions, Macros) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupTabDirector" Content="STUDIO &amp; AI" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupTabDirector}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupTabDirector}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="6" Margin="8" MinWidth="185">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="STUDIO, CREW &amp; AI" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="8,2,8,4"/>
                                    <Button x:Name="TabRoom" Content="ROOM &amp; CREW" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Room"/>
                                    <Button x:Name="TabShotSuggestions" Content="SHOT SUGGESTIONS" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="ShotSuggestions"/>
                                    <Button x:Name="TabMacros" Content="MACROS" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Macros"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- BROADCAST & I/O GROUP (Stream, Record, Outputs, Connection) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupTabBroadcast" Content="BROADCAST" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupTabBroadcast}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupTabBroadcast}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="6" Margin="8" MinWidth="180">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="BROADCAST &amp; I/O" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="8,2,8,4"/>
                                    <Button x:Name="TabStream" Content="STREAM" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Stream"/>
                                    <Button x:Name="TabRecord" Content="RECORD" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Record"/>
                                    <Button x:Name="TabOutputs" Content="OUTPUTS" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Outputs"/>
                                    <Button x:Name="TabConnection" Content="CONNECTION" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="ViewTab_Click" Tag="Connection"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Width="1" Height="24" Background="#444450" Margin="8,0"/>

                    <!-- Primary Live Transition Action Buttons -->
                    <Button x:Name="BtnCut" Content="CUT" Style="{StaticResource TransitionActionButton}" Click="CutButton_Click"/>
                    <Button x:Name="BtnAuto" Content="AUTO" Style="{StaticResource TransitionActionButton}" Click="AutoButton_Click"/>

                    <!-- Rate control (Slider + Readout) -->
                    <Border Background="#1B1B22" CornerRadius="5" BorderBrush="#3A3A48" BorderThickness="1" Padding="7,3" Margin="4,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RATE" Foreground="#9A9AA8" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="RateSlider" Minimum="0.1" Maximum="5.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Width="72" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                    ValueChanged="RateSlider_ValueChanged"/>
                            <Border Background="#111116" CornerRadius="3" BorderBrush="#2E2E3A" BorderThickness="1" Padding="3,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="RateTextBox" Text="1.0" Width="30" FontSize="11.5" FontWeight="SemiBold" Background="Transparent" Foreground="#FF9800" CaretBrush="#FF9800" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="RateTextBox_LostFocus" PreviewKeyDown="RateTextBox_PreviewKeyDown"/>
                                    <TextBlock Text="s" Foreground="#888894" FontSize="10.5" VerticalAlignment="Center" Margin="1,0,3,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnFtb" Content="FTB" Style="{StaticResource TransitionActionButton}" Click="Ftb_Click" Margin="6,3,3,3"/>

                    <Border Width="1" Height="24" Background="#444450" Margin="8,0"/>

                    <!-- TRANSITION STYLE GROUP (MIX / DIP / WIPE / STING / DVE + FTB Rate) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupTransitionStyle" Content="STYLE" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupTransitionStyle}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupTransitionStyle}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="TRANSITION STYLE" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="4,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnMix" Content="MIX" Style="{StaticResource TransitionStyleButtonSelected}" Click="TransitionStyle_Click" Tag="Mix"/>
                                        <Button x:Name="BtnDip" Content="DIP" Style="{StaticResource TransitionStyleButton}" Click="TransitionStyle_Click" Tag="Dip"/>
                                        <Button x:Name="BtnWipe" Content="WIPE" Style="{StaticResource TransitionStyleButton}" Click="TransitionStyle_Click" Tag="Wipe"/>
                                        <Button x:Name="BtnSting" Content="STING" Style="{StaticResource TransitionStyleButton}" Click="TransitionStyle_Click" Tag="Stinger"/>
                                        <Button x:Name="BtnDve" Content="DVE" Style="{StaticResource TransitionStyleButton}" Click="TransitionStyle_Click" Tag="DVE"/>
                                    </StackPanel>
                                    <Border Height="1" Background="#2E2E3A" Margin="4,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="FTB RATE:" Foreground="#888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                        <Slider x:Name="FtbRateSlider" Minimum="0.1" Maximum="5.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Width="95" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                                ValueChanged="FtbRateSlider_ValueChanged"/>
                                        <Border Background="#333" CornerRadius="4" BorderBrush="#555" BorderThickness="1" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="FtbRateText" Text="1.0" Width="36" FontSize="12" Background="#222" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="FtbRate_LostFocus"/>
                                                <TextBlock Text="s" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- KEYERS & NEXT TRANSITION GROUP -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupKeyers" Content="KEYERS" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupKeyers}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupKeyers}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="NEXT TRANSITION" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="4,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnNextBkgd" Content="BKGD" Style="{StaticResource TransitionStyleButtonSelected}" Click="NextTransition_Click" Tag="Background"/>
                                        <Button x:Name="BtnNextKey1" Content="KEY 1" Style="{StaticResource TransitionStyleButton}" Click="NextTransition_Click" Tag="Key1"/>
                                        <Button x:Name="BtnNextKey2" Content="KEY 2" Style="{StaticResource TransitionStyleButton}" Click="NextTransition_Click" Tag="Key2"/>
                                        <Button x:Name="BtnNextKey3" Content="KEY 3" Style="{StaticResource TransitionStyleButton}" Click="NextTransition_Click" Tag="Key3"/>
                                        <Button x:Name="BtnNextKey4" Content="KEY 4" Style="{StaticResource TransitionStyleButton}" Click="NextTransition_Click" Tag="Key4"/>
                                    </StackPanel>
                                    <Border Height="1" Background="#2E2E3A" Margin="4,8"/>
                                    <TextBlock Text="UPSTREAM KEYERS ON AIR" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="4,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOnAir1" Content="KEY 1 ON AIR" Style="{StaticResource TransitionStyleButton}" Click="OnAir_Click" Tag="0"/>
                                        <Button x:Name="BtnOnAir2" Content="KEY 2 ON AIR" Style="{StaticResource TransitionStyleButton}" Click="OnAir_Click" Tag="1"/>
                                        <Button x:Name="BtnOnAir3" Content="KEY 3 ON AIR" Style="{StaticResource TransitionStyleButton}" Click="OnAir_Click" Tag="2"/>
                                        <Button x:Name="BtnOnAir4" Content="KEY 4 ON AIR" Style="{StaticResource TransitionStyleButton}" Click="OnAir_Click" Tag="3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- DSK 1 & 2 GROUP -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupDsk" Content="DSK" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupDsk}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupDsk}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="DOWNSTREAM KEYERS (DSK 1 &amp; DSK 2)" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="4,0,0,6"/>
                                    <!-- DSK 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="DSK 1" Width="42" Foreground="#D4D4DC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <Button x:Name="BtnDsk1Tie" Content="TIE" Style="{StaticResource TransitionStyleButton}" Click="DskTie_Click" Tag="0"/>
                                        <Border Background="#333" CornerRadius="4" BorderBrush="#555" BorderThickness="1" Padding="4,2" Margin="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="RATE" Foreground="#888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,5,0"/>
                                                <Slider x:Name="Dsk1RateSlider" Minimum="0.1" Maximum="5.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                        Width="68" VerticalAlignment="Center" Margin="0,0,5,0" Cursor="Hand" Tag="0"
                                                        ValueChanged="DskRateSlider_ValueChanged"/>
                                                <TextBox x:Name="Dsk1RateText" Text="1.0" Width="32" FontSize="12" Background="#222" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="DskRate_LostFocus" Tag="0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnDsk1OnAir" Content="ON AIR" Style="{StaticResource TransitionStyleButton}" Click="DskOnAir_Click" Tag="0"/>
                                        <Button x:Name="BtnDsk1Auto" Content="AUTO" Style="{StaticResource TransitionActionButton}" Click="DskAuto_Click" Tag="0"/>
                                    </StackPanel>
                                    <Border Height="1" Background="#2E2E3A" Margin="4,6"/>
                                    <!-- DSK 2 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="DSK 2" Width="42" Foreground="#D4D4DC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <Button x:Name="BtnDsk2Tie" Content="TIE" Style="{StaticResource TransitionStyleButton}" Click="DskTie_Click" Tag="1"/>
                                        <Border Background="#333" CornerRadius="4" BorderBrush="#555" BorderThickness="1" Padding="4,2" Margin="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="RATE" Foreground="#888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,5,0"/>
                                                <Slider x:Name="Dsk2RateSlider" Minimum="0.1" Maximum="5.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                        Width="68" VerticalAlignment="Center" Margin="0,0,5,0" Cursor="Hand" Tag="1"
                                                        ValueChanged="DskRateSlider_ValueChanged"/>
                                                <TextBox x:Name="Dsk2RateText" Text="1.0" Width="32" FontSize="12" Background="#222" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="DskRate_LostFocus" Tag="1"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnDsk2OnAir" Content="ON AIR" Style="{StaticResource TransitionStyleButton}" Click="DskOnAir_Click" Tag="1"/>
                                        <Button x:Name="BtnDsk2Auto" Content="AUTO" Style="{StaticResource TransitionActionButton}" Click="DskAuto_Click" Tag="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- FLOATING DOCKS GROUP (SuperSource & Palettes) -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupDocks" Content="DOCKS" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupDocks}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupDocks}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="6" Margin="8" MinWidth="165">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="FLOATING DOCKS" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="8,2,8,4"/>
                                    <Button x:Name="BtnSuperSource" Content="SUPERSOURCE" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="DockToggle_Click" Tag="SuperSource"/>
                                    <Button x:Name="BtnPalettes" Content="PALETTES" Style="{StaticResource ViewTabButton}" HorizontalContentAlignment="Left" Click="DockToggle_Click" Tag="Palettes"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- VOICE CONTROL GROUP -->
                    <Grid VerticalAlignment="Center">
                        <ToggleButton x:Name="GroupVoice" Content="VOICE" Style="{StaticResource ViewGroupToggleButton}"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=GroupVoice}" StaysOpen="False" PlacementTarget="{Binding ElementName=GroupVoice}" Placement="Top" VerticalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1B1B22" BorderBrush="#3A3A48" BorderThickness="1" CornerRadius="6" Padding="10" Margin="8" MinWidth="240">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.72"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="VOICE SWITCHING CONTROL" FontSize="9.5" FontWeight="Bold" Foreground="#787888" Margin="2,0,0,6"/>
                                    <ToggleButton x:Name="BtnVoiceControl"
                                                  Content="VOICE CONTROL"
                                                  Style="{StaticResource VoiceTabToggleButton}"
                                                  Click="VoiceControlToggle_Click"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,8"/>
                                    <TextBlock Text="MICROPHONE INPUT" FontSize="9" FontWeight="Bold" Foreground="#888" Margin="2,0,0,3"/>
                                    <ComboBox x:Name="ComboMicrophone"
                                              Width="220"
                                              Height="28"
                                              FontSize="11.5"
                                              Margin="0,0,0,8"
                                              SelectionChanged="ComboMicrophone_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="WAKE WORD:" Foreground="#888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <TextBox x:Name="TxtWakeWord"
                                                 Width="130"
                                                 Height="26"
                                                 FontSize="11.5"
                                                 Background="#121216"
                                                 Foreground="#E4E4E7"
                                                 BorderBrush="#3D3D48"
                                                 BorderThickness="1"
                                                 VerticalContentAlignment="Center"
                                                 Padding="6,0"
                                                 LostFocus="TxtWakeWord_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </StackPanel>
            </ScrollViewer><RepeatButton x:Name="BtnScrollRight" Grid.Column="2"  Foreground="#888" Background="Transparent" BorderThickness="0" Padding="8,0" Click="BtnScrollRight_Click" VerticalAlignment="Stretch" Visibility="Collapsed" Cursor="Hand" ><Path Data="M 0,0 L 6,5 L 0,10" Stroke="#888" StrokeThickness="2" VerticalAlignment="Center" Fill="Transparent"/></RepeatButton></Grid></Border>

        <!-- 5. STATUS BAR -->
        <Border x:Name="StatusBar" Grid.Row="4" Background="#333">
             <DockPanel LastChildFill="False">
                 <TextBlock x:Name="NotificationStatusText" Text="Ready" Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
                 <TextBlock x:Name="SpeechStatusText" Text="" Foreground="#FFD700" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0"/>
                 <TextBlock x:Name="StatusText" Text="Disconnected" DockPanel.Dock="Right" Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
             </DockPanel>
        </Border>

        <!-- Active Inputs Overlay Modal -->
        <Border x:Name="EditInputsOverlay" 
                Visibility="Collapsed" 
                Background="#C0000000" 
                MouseLeftButtonDown="OverlayBackground_Click"
                Panel.ZIndex="1000">
            <Border Background="#141416" 
                    Padding="20,16" 
                    CornerRadius="8"
                    BorderBrush="#3D3D44"
                    BorderThickness="1"
                    MaxWidth="920"
                    MaxHeight="520"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar with Title, Subtitle, and Top-Right Close 'X' Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EDIT ACTIVE SWITCHER INPUTS" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       Foreground="#FF9800"/>
                            <TextBlock Text="Enable inputs and configure camera roles &amp; capture hardware. Only enabled inputs appear on the switcher bus." 
                                       FontSize="11" 
                                       Foreground="#A1A1AA"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Top-Right Close Button -->
                        <Button Grid.Column="1" 
                                Content="X" 
                                Click="EditDone_Click"
                                Width="30" Height="30"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#CCCCCC"
                                Background="#2A2A30"
                                BorderThickness="1"
                                BorderBrush="#44444C"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                ToolTip="Close Edit Window">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D32F2F"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Input Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl x:Name="EditInputList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Done & Cancel Button Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Save" 
                                Click="EditDone_Click"
                                Padding="28,8"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#00C853"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00E676"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Cancel" 
                                Click="EditDone_Click"
                                Margin="12,0,0,0"
                                Padding="20,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#333338"/>
                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#55555C"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#44444C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- 7. QR CODE OVERLAY -->
        <Border x:Name="QrOverlay" 
                Background="#EE111111" 
                Visibility="Collapsed"
                Grid.RowSpan="5"
                Panel.ZIndex="2000">
            <Border Background="#2B2B2B" 
                    Padding="30" 
                    CornerRadius="12"
                    BorderBrush="#555"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Join Room" FontSize="22" FontWeight="Bold" Foreground="#EEEEEE" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Scan with your phone's camera to join instantly." FontSize="14" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Border Background="White" Padding="10" CornerRadius="8" HorizontalAlignment="Center">
                        <Image x:Name="ImgQrCode" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="Room Code: " FontSize="15" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQrRoomId" Text="------" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PIN: " FontSize="15" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQrPin" Text="----" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="Switcher Control Code: " FontSize="15" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQrControlCode" Text="----" FontSize="18" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtQrJoinUrl" Text="https://..." FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="340"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Copy Link" Click="BtnCopyLink_Click" Margin="0,0,12,0" Padding="20,8" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Background="#3A3A3A" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Close" Click="BtnCloseQr_Click" Padding="25,8" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Background="#0078D4" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>









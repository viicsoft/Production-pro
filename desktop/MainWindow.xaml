<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATEM Software Control"
        Height="850" Width="1400"
        Background="#1B1B1B"
        Foreground="#D0D0D0"
        FontFamily="Segoe UI"
        Icon="icon.png">

    <Window.Resources>
        <!-- ================= COLORS ================= -->
        <SolidColorBrush x:Key="WindowBg" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#282828"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="TextNormal" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#999999"/>
        
        <!-- ================= STYLES ================= -->

        <!-- Generic Switcher Button (Glassy Look) -->
        <Style x:Key="SwitcherButton" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Outer Bevel/Shadow -->
                            <Border CornerRadius="4" BorderThickness="0,0,0,1" BorderBrush="#101010">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#E0E0E0" Offset="0.0"/>
                                        <GradientStop Color="#AAAAAA" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <!-- Inner Glass Highlight -->
                                    <Border CornerRadius="3" Margin="1" Opacity="0.8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Label -->
                                    <TextBlock Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Effect="{x:Null}"/>
                                </Grid>
                            </Border>
                            
                            <!-- Pressed State Overlay -->
                            <Border x:Name="PressedOverlay" CornerRadius="4" Background="#33000000" Visibility="Collapsed"/>
                            
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay" Property="Visibility" Value="Visible"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Program Button -->
        <Style x:Key="ProgramButton" TargetType="Button" BasedOn="{StaticResource SwitcherButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Red Glow -->
                            <Border CornerRadius="4" Background="#CC0000" BorderBrush="#FF0000" BorderThickness="0,0,0,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>

                            <!-- Gradient Over -->
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF4444" Offset="0"/>
                                        <GradientStop Color="#AA0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Inner Glass -->
                            <Border CornerRadius="3" Margin="1" Opacity="0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Preview Button -->
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource SwitcherButton}">
             <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                             <!-- Green Glow -->
                            <Border CornerRadius="4" Background="#008800" BorderBrush="#00FF00" BorderThickness="0,0,0,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF00" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>

                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#44AA44" Offset="0"/>
                                        <GradientStop Color="#006600" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border CornerRadius="3" Margin="1" Opacity="0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Yellow Transition Button -->
        <Style x:Key="YellowButton" TargetType="Button" BasedOn="{StaticResource SwitcherButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                             <Border CornerRadius="4" Background="#FFB300" BorderBrush="#FFD740" BorderThickness="0,0,0,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD740" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>

                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFCA28" Offset="0"/>
                                        <GradientStop Color="#FF6F00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border CornerRadius="3" Margin="1" Opacity="0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.5">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       FontWeight="ExtraBold"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Palette Header Style -->
        <Style x:Key="PaletteHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        
        <!-- Tally Item Template (Simplified for right panel) -->
        <DataTemplate x:Key="TallyItemTemplate">
            <Border Margin="2" Padding="6" Background="#333" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="10" Height="10" CornerRadius="5" Margin="4,0,0,0">
                         <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Program}" Value="True">
                                        <Setter Property="Background" Value="Red"/>
                                    </DataTrigger>
                                     <DataTrigger Binding="{Binding Preview}" Value="True">
                                        <Setter Property="Background" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding CamAlias}" Foreground="White" FontWeight="Bold"/>
                </DockPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Menu -->
            <RowDefinition Height="Auto"/> <!-- Header Block -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
            <RowDefinition Height="24"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. MENU BAR -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Padding="2">
                <MenuItem Header="File"/>
                <MenuItem Header="Macros"/>
                <MenuItem Header="Outputs"/>
                <MenuItem Header="Stream"/>
                <MenuItem Header="Record"/>
                <MenuItem Header="Connection">
                    <MenuItem Header="Host Settings" StaysOpenOnClick="True">
                       <MenuItem.Icon>
                           <TextBlock Text="IP" FontWeight="Bold"/>
                       </MenuItem.Icon>
                       <StackPanel Orientation="Horizontal" Width="200">
                           <TextBlock Text="Host:" VerticalAlignment="Center" Margin="5"/>
                           <TextBox x:Name="Host" Text="127.0.0.1" Width="120"/>
                       </StackPanel>
                    </MenuItem>
                    <MenuItem Header="Connect" Click="Connect_Click" FontWeight="Bold"/>
                </MenuItem>
                <MenuItem Header="Help"/>
            </Menu>
        </Border>

        <!-- 2. HEADER -->
        <Grid Grid.Row="1" Background="{StaticResource PanelBg}" Height="60">
            <TextBlock Text="ATEM Software Control" 
                       Foreground="#888" 
                       FontSize="24" 
                       FontWeight="Light" 
                       VerticalAlignment="Center" 
                       Margin="20,0"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Viicsoft design" Foreground="White" FontSize="16"  FontFamily="Segoe UI Semilight" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <Border Width="6" Height="6" Background="#FFA500" CornerRadius="3" Margin="0,1"/>
                    <Border Width="6" Height="6" Background="#FFA500" CornerRadius="3" Margin="0,1"/>
                    <Border Width="6" Height="6" Background="#FFA500" CornerRadius="3" Margin="0,1"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN BODY -->
        <Grid Grid.Row="2" Background="{StaticResource WindowBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- Switcher -->
                <ColumnDefinition Width="Auto"/> <!-- Palettes (Auto width for collapsing) -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: SWITCHER PANELS -->
            <Grid Grid.Column="0" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Buses -->
                    <ColumnDefinition Width="Auto"/> <!-- Fader -->
                    <ColumnDefinition Width="Auto"/> <!-- Controls (Trans + DSK) -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                </Grid.ColumnDefinitions>

                <!-- COL 0: UNIFIED BUSES (Program / Preview) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                    <StackPanel VerticalAlignment="Top">
                        <!-- BUS 1-10 -->
                        <TextBlock Text="Program / Preview (1-10)" Foreground="#666" Margin="4,0,0,4"/>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Program Row -->
                                <UniformGrid Rows="1" Columns="10">
                                    <Button x:Name="PgmBtn1" Content="Cam1" Style="{StaticResource SwitcherButton}" Click="Cut1_Click"/>
                                    <Button x:Name="PgmBtn2" Content="Cam2" Style="{StaticResource SwitcherButton}" Click="Cut2_Click"/>
                                    <Button x:Name="PgmBtn3" Content="Cam3" Style="{StaticResource SwitcherButton}" Click="Cut3_Click"/>
                                    <Button x:Name="PgmBtn4" Content="Cam4" Style="{StaticResource SwitcherButton}" Click="Cut4_Click"/>
                                    <Button x:Name="PgmBtn5" Content="Cam5" Style="{StaticResource SwitcherButton}" Click="Cut5_Click"/>
                                    <Button x:Name="PgmBtn6" Content="Cam6" Style="{StaticResource SwitcherButton}" Click="Cut6_Click"/>
                                    <Button x:Name="PgmBtn7" Content="Cam7" Style="{StaticResource SwitcherButton}" Click="Cut7_Click"/>
                                    <Button x:Name="PgmBtn8" Content="Cam8" Style="{StaticResource SwitcherButton}" Click="Cut8_Click"/>
                                    <Button x:Name="PgmBtn9" Content="Cam9" Style="{StaticResource SwitcherButton}" Click="Cut9_Click"/>
                                    <Button x:Name="PgmBtn10" Content="Cam10" Style="{StaticResource SwitcherButton}" Click="Cut10_Click"/>
                                </UniformGrid>
                                
                                <!-- Preview Row -->
                                <UniformGrid Rows="1" Columns="10" Margin="0,10,0,0">
                                    <Button x:Name="PrvBtn1" Content="Cam1" Style="{StaticResource SwitcherButton}" Click="Prev1_Click"/>
                                    <Button x:Name="PrvBtn2" Content="Cam2" Style="{StaticResource SwitcherButton}" Click="Prev2_Click"/>
                                    <Button x:Name="PrvBtn3" Content="Cam3" Style="{StaticResource SwitcherButton}" Click="Prev3_Click"/>
                                    <Button x:Name="PrvBtn4" Content="Cam4" Style="{StaticResource SwitcherButton}" Click="Prev4_Click"/>
                                    <Button x:Name="PrvBtn5" Content="Cam5" Style="{StaticResource SwitcherButton}" Click="Prev5_Click"/>
                                    <Button x:Name="PrvBtn6" Content="Cam6" Style="{StaticResource SwitcherButton}" Click="Prev6_Click"/>
                                    <Button x:Name="PrvBtn7" Content="Cam7" Style="{StaticResource SwitcherButton}" Click="Prev7_Click"/>
                                    <Button x:Name="PrvBtn8" Content="Cam8" Style="{StaticResource SwitcherButton}" Click="Prev8_Click"/>
                                    <Button x:Name="PrvBtn9" Content="Cam9" Style="{StaticResource SwitcherButton}" Click="Prev9_Click"/>
                                    <Button x:Name="PrvBtn10" Content="Cam10" Style="{StaticResource SwitcherButton}" Click="Prev10_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- BUS 11-20 (Collapsible) -->
                        <Expander x:Name="Expander1120" Header="Program / Preview (11-20)" 
                                  IsExpanded="False" 
                                  Margin="0,15,0,0"
                                  Foreground="#DDDDDD">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#666" FontSize="12"/>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="10" Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Program Row -->
                                <UniformGrid Rows="1" Columns="10">
                                    <Button x:Name="PgmBtn11" Content="Cam11" Style="{StaticResource SwitcherButton}" Click="Cut11_Click"/>
                                    <Button x:Name="PgmBtn12" Content="Cam12" Style="{StaticResource SwitcherButton}" Click="Cut12_Click"/>
                                    <Button x:Name="PgmBtn13" Content="Cam13" Style="{StaticResource SwitcherButton}" Click="Cut13_Click"/>
                                    <Button x:Name="PgmBtn14" Content="Cam14" Style="{StaticResource SwitcherButton}" Click="Cut14_Click"/>
                                    <Button x:Name="PgmBtn15" Content="Cam15" Style="{StaticResource SwitcherButton}" Click="Cut15_Click"/>
                                    <Button x:Name="PgmBtn16" Content="Cam16" Style="{StaticResource SwitcherButton}" Click="Cut16_Click"/>
                                    <Button x:Name="PgmBtn17" Content="Cam17" Style="{StaticResource SwitcherButton}" Click="Cut17_Click"/>
                                    <Button x:Name="PgmBtn18" Content="Cam18" Style="{StaticResource SwitcherButton}" Click="Cut18_Click"/>
                                    <Button x:Name="PgmBtn19" Content="Cam19" Style="{StaticResource SwitcherButton}" Click="Cut19_Click"/>
                                    <Button x:Name="PgmBtn20" Content="Cam20" Style="{StaticResource SwitcherButton}" Click="Cut20_Click"/>
                                </UniformGrid>
                                
                                <!-- Preview Row -->
                                <UniformGrid Rows="1" Columns="10" Margin="0,10,0,0">
                                    <Button x:Name="PrvBtn11" Content="Cam11" Style="{StaticResource SwitcherButton}" Click="Prev11_Click"/>
                                    <Button x:Name="PrvBtn12" Content="Cam12" Style="{StaticResource SwitcherButton}" Click="Prev12_Click"/>
                                    <Button x:Name="PrvBtn13" Content="Cam13" Style="{StaticResource SwitcherButton}" Click="Prev13_Click"/>
                                    <Button x:Name="PrvBtn14" Content="Cam14" Style="{StaticResource SwitcherButton}" Click="Prev14_Click"/>
                                    <Button x:Name="PrvBtn15" Content="Cam15" Style="{StaticResource SwitcherButton}" Click="Prev15_Click"/>
                                    <Button x:Name="PrvBtn16" Content="Cam16" Style="{StaticResource SwitcherButton}" Click="Prev16_Click"/>
                                    <Button x:Name="PrvBtn17" Content="Cam17" Style="{StaticResource SwitcherButton}" Click="Prev17_Click"/>
                                    <Button x:Name="PrvBtn18" Content="Cam18" Style="{StaticResource SwitcherButton}" Click="Prev18_Click"/>
                                    <Button x:Name="PrvBtn19" Content="Cam19" Style="{StaticResource SwitcherButton}" Click="Prev19_Click"/>
                                    <Button x:Name="PrvBtn20" Content="Cam20" Style="{StaticResource SwitcherButton}" Click="Prev20_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        </Expander>

                        <!-- BUS 21-30 (Collapsible) -->
                        <Expander x:Name="Expander2130" Header="Program / Preview (21-30)" 
                                  IsExpanded="False" 
                                  Margin="0,5,0,0"
                                  Foreground="#DDDDDD">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#666" FontSize="12"/>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="10" Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Program Row -->
                                <UniformGrid Rows="1" Columns="10">
                                    <Button x:Name="PgmBtn21" Content="Cam21" Style="{StaticResource SwitcherButton}" Click="Cut21_Click"/>
                                    <Button x:Name="PgmBtn22" Content="Cam22" Style="{StaticResource SwitcherButton}" Click="Cut22_Click"/>
                                    <Button x:Name="PgmBtn23" Content="Cam23" Style="{StaticResource SwitcherButton}" Click="Cut23_Click"/>
                                    <Button x:Name="PgmBtn24" Content="Cam24" Style="{StaticResource SwitcherButton}" Click="Cut24_Click"/>
                                    <Button x:Name="PgmBtn25" Content="Cam25" Style="{StaticResource SwitcherButton}" Click="Cut25_Click"/>
                                    <Button x:Name="PgmBtn26" Content="Cam26" Style="{StaticResource SwitcherButton}" Click="Cut26_Click"/>
                                    <Button x:Name="PgmBtn27" Content="Cam27" Style="{StaticResource SwitcherButton}" Click="Cut27_Click"/>
                                    <Button x:Name="PgmBtn28" Content="Cam28" Style="{StaticResource SwitcherButton}" Click="Cut28_Click"/>
                                    <Button x:Name="PgmBtn29" Content="Cam29" Style="{StaticResource SwitcherButton}" Click="Cut29_Click"/>
                                    <Button x:Name="PgmBtn30" Content="Cam30" Style="{StaticResource SwitcherButton}" Click="Cut30_Click"/>
                                </UniformGrid>
                                
                                <!-- Preview Row -->
                                <UniformGrid Rows="1" Columns="10" Margin="0,10,0,0">
                                    <Button x:Name="PrvBtn21" Content="Cam21" Style="{StaticResource SwitcherButton}" Click="Prev21_Click"/>
                                    <Button x:Name="PrvBtn22" Content="Cam22" Style="{StaticResource SwitcherButton}" Click="Prev22_Click"/>
                                    <Button x:Name="PrvBtn23" Content="Cam23" Style="{StaticResource SwitcherButton}" Click="Prev23_Click"/>
                                    <Button x:Name="PrvBtn24" Content="Cam24" Style="{StaticResource SwitcherButton}" Click="Prev24_Click"/>
                                    <Button x:Name="PrvBtn25" Content="Cam25" Style="{StaticResource SwitcherButton}" Click="Prev25_Click"/>
                                    <Button x:Name="PrvBtn26" Content="Cam26" Style="{StaticResource SwitcherButton}" Click="Prev26_Click"/>
                                    <Button x:Name="PrvBtn27" Content="Cam27" Style="{StaticResource SwitcherButton}" Click="Prev27_Click"/>
                                    <Button x:Name="PrvBtn28" Content="Cam28" Style="{StaticResource SwitcherButton}" Click="Prev28_Click"/>
                                    <Button x:Name="PrvBtn29" Content="Cam29" Style="{StaticResource SwitcherButton}" Click="Prev29_Click"/>
                                    <Button x:Name="PrvBtn30" Content="Cam30" Style="{StaticResource SwitcherButton}" Click="Prev30_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        </Expander>

                        <!-- BUS 31-40 (Collapsible) -->
                        <Expander x:Name="Expander3140" Header="Program / Preview (31-40)" 
                                  IsExpanded="False" 
                                  Margin="0,5,0,0"
                                  Foreground="#DDDDDD">
                            <Expander.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#666" FontSize="12"/>
                                </DataTemplate>
                            </Expander.HeaderTemplate>
                        <Border Background="{StaticResource PanelBg}" CornerRadius="10" Padding="10" Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Program Row -->
                                <UniformGrid Rows="1" Columns="10">
                                    <Button x:Name="PgmBtn31" Content="Cam31" Style="{StaticResource SwitcherButton}" Click="Cut31_Click"/>
                                    <Button x:Name="PgmBtn32" Content="Cam32" Style="{StaticResource SwitcherButton}" Click="Cut32_Click"/>
                                    <Button x:Name="PgmBtn33" Content="Cam33" Style="{StaticResource SwitcherButton}" Click="Cut33_Click"/>
                                    <Button x:Name="PgmBtn34" Content="Cam34" Style="{StaticResource SwitcherButton}" Click="Cut34_Click"/>
                                    <Button x:Name="PgmBtn35" Content="Cam35" Style="{StaticResource SwitcherButton}" Click="Cut35_Click"/>
                                    <Button x:Name="PgmBtn36" Content="Cam36" Style="{StaticResource SwitcherButton}" Click="Cut36_Click"/>
                                    <Button x:Name="PgmBtn37" Content="Cam37" Style="{StaticResource SwitcherButton}" Click="Cut37_Click"/>
                                    <Button x:Name="PgmBtn38" Content="Cam38" Style="{StaticResource SwitcherButton}" Click="Cut38_Click"/>
                                    <Button x:Name="PgmBtn39" Content="Cam39" Style="{StaticResource SwitcherButton}" Click="Cut39_Click"/>
                                    <Button x:Name="PgmBtn40" Content="Cam40" Style="{StaticResource SwitcherButton}" Click="Cut40_Click"/>
                                </UniformGrid>
                                
                                <!-- Preview Row -->
                                <UniformGrid Rows="1" Columns="10" Margin="0,10,0,0">
                                    <Button x:Name="PrvBtn31" Content="Cam31" Style="{StaticResource SwitcherButton}" Click="Prev31_Click"/>
                                    <Button x:Name="PrvBtn32" Content="Cam32" Style="{StaticResource SwitcherButton}" Click="Prev32_Click"/>
                                    <Button x:Name="PrvBtn33" Content="Cam33" Style="{StaticResource SwitcherButton}" Click="Prev33_Click"/>
                                    <Button x:Name="PrvBtn34" Content="Cam34" Style="{StaticResource SwitcherButton}" Click="Prev34_Click"/>
                                    <Button x:Name="PrvBtn35" Content="Cam35" Style="{StaticResource SwitcherButton}" Click="Prev35_Click"/>
                                    <Button x:Name="PrvBtn36" Content="Cam36" Style="{StaticResource SwitcherButton}" Click="Prev36_Click"/>
                                    <Button x:Name="PrvBtn37" Content="Cam37" Style="{StaticResource SwitcherButton}" Click="Prev37_Click"/>
                                    <Button x:Name="PrvBtn38" Content="Cam38" Style="{StaticResource SwitcherButton}" Click="Prev38_Click"/>
                                    <Button x:Name="PrvBtn39" Content="Cam39" Style="{StaticResource SwitcherButton}" Click="Prev39_Click"/>
                                    <Button x:Name="PrvBtn40" Content="Cam40" Style="{StaticResource SwitcherButton}" Click="Prev40_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- COL 1: TRANSITION CONTROLS -->
                <!-- COL 1: FADER -->
                <Grid Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Stretch">
                         <Grid Width="80">
                             <!-- Track Background -->
                             <Border Background="#222" CornerRadius="4" BorderBrush="#555" BorderThickness="1"/>
                             
                             <!-- Tick Marks -->
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                                 <Rectangle Height="1" Fill="#AAA" Width="20" Margin="0,6"/>
                             </StackPanel>
                             
                             <!-- Functional Slider -->
                             <Slider x:Name="TransitionFader"
                                     Orientation="Vertical"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     TickFrequency="10"
                                     IsSnapToTickEnabled="False"
                                     VerticalAlignment="Stretch"
                                     Margin="25,15"
                                     ValueChanged="TransitionFader_ValueChanged"
                                     MouseWheel="TransitionFader_MouseWheel"
                                     Background="Transparent"
                                     Cursor="Hand"/>
                         </Grid>
                    </Grid>

                <!-- COL 2: CONTROLS (Transition + DSK) -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                     <!-- Next Transition -->
                    <StackPanel Margin="0,0,0,15">
                         <TextBlock Text="Next Transition" Foreground="#666" Margin="0,0,0,4"/>
                         <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="10">
                             <UniformGrid Columns="4">
                                 <Button Content="ON&#x0a;AIR" Style="{StaticResource SwitcherButton}"/>
                                 <Button Content="ON&#x0a;AIR" Style="{StaticResource SwitcherButton}"/>
                                 <Button Content="ON&#x0a;AIR" Style="{StaticResource SwitcherButton}"/>
                                 <Button Content="ON&#x0a;AIR" Style="{StaticResource SwitcherButton}"/>
                                 
                                 <Button Content="BKGD" Style="{StaticResource YellowButton}"/>
                                 <Button Content="KEY 1" Style="{StaticResource SwitcherButton}"/>
                                 <Button Content="KEY 2" Style="{StaticResource SwitcherButton}"/>
                                 <Button Content="KEY 3" Style="{StaticResource SwitcherButton}"/>
                             </UniformGrid>
                         </Border>
                    </StackPanel>

                    <!-- Transition Style -->
                     <StackPanel Margin="0,0,0,15">
                         <TextBlock Text="Transition Style" Foreground="#666" Margin="0,0,0,4"/>
                         <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="10">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="20"/>
                                     <RowDefinition Height="Auto"/>
                                 </Grid.RowDefinitions>
                                 <UniformGrid Columns="4" Rows="1">
                                     <Button Content="MIX" Style="{StaticResource YellowButton}"/>
                                     <Button Content="DIP" Style="{StaticResource SwitcherButton}"/>
                                     <Button Content="WIPE" Style="{StaticResource SwitcherButton}"/>
                                     <Button Content="DVE" Style="{StaticResource SwitcherButton}"/>
                                 </UniformGrid>
                                 
                                 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                     <Button Content="PREV&#x0a;TRANS" Style="{StaticResource SwitcherButton}" FontSize="9"/>
                                     <Button Content="CUT" Style="{StaticResource SwitcherButton}" Click="CutTransition_Click"/>
                                     <Button Content="AUTO" Style="{StaticResource SwitcherButton}" Click="AutoTransition_Click"/>
                                 </StackPanel>
                             </Grid>
                         </Border>
                    </StackPanel>

                     <!-- DSK 1 -->
                     <TextBlock Text="DSK 1" Foreground="#666" Margin="0,0,0,4"/>
                     <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="10">
                         <StackPanel>
                             <Button Content="TIE" Style="{StaticResource SwitcherButton}"/>
                             <TextBlock Text="Rate" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10"/>
                             <TextBlock Text="1:00" Foreground="#FFA500" HorizontalAlignment="Center" Margin="0,0,0,5" FontWeight="Bold"/>
                             <Button Content="ON&#x0a;AIR" Style="{StaticResource SwitcherButton}"/>
                             <Button Content="AUTO" Style="{StaticResource SwitcherButton}"/>
                         </StackPanel>
                     </Border>
                     
                     <!-- Fade to Black -->
                     <TextBlock Text="Fade to Black" Foreground="#666" Margin="0,15,0,4"/>
                     <Border Background="{StaticResource PanelBg}" CornerRadius="8" Padding="10">
                         <StackPanel>
                             <TextBlock Text="Rate" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,0" FontSize="10"/>
                             <TextBlock Text="1:00" Foreground="#FFA500" HorizontalAlignment="Center" Margin="0,0,0,5" FontWeight="Bold"/>
                             <Button Content="FTB" Style="{StaticResource SwitcherButton}"/>
                         </StackPanel>
                     </Border>
                </StackPanel>
            </Grid>

            <!-- RIGHT: PALETTES -->
            <Border Grid.Column="1" Background="#222" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                        <RowDefinition Height="*"/>    <!-- Content -->
                    </Grid.RowDefinitions>
                    
                    <Border Background="#2B2B2B" Padding="10">
                        <ComboBox x:Name="PalettesDropdown" SelectedIndex="0" Height="28" Foreground="Black" BorderBrush="#555" SelectionChanged="PalettesDropdown_SelectionChanged">
                            <ComboBoxItem Content="— Close Panel —" IsSelected="True"/>
                            <ComboBoxItem Content="Palettes"/>
                            <ComboBoxItem Content="Media"/>
                            <ComboBoxItem Content="Output"/>
                        </ComboBox>
                    </Border>

                    <ScrollViewer x:Name="SidebarContent" Grid.Row="1" Visibility="Collapsed" Width="260">
                        <StackPanel>
                            <TextBlock Text="Color Generators" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="SuperSource" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="Upstream Key 1" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="Upstream Key 2" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="Transitions" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="Downstream Keys" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <TextBlock Text="Fade to Black" Style="{StaticResource PaletteHeader}"/>
                            <Rectangle Height="1" Fill="#333"/>
                            
                            <!-- Insert Tally List here as a "Palette" so it's visible -->
                           <TextBlock Text="Tally Status (Active)" Style="{StaticResource PaletteHeader}" Foreground="White"/>
                           <ItemsControl x:Name="TallyList" ItemTemplate="{StaticResource TallyItemTemplate}" Margin="0,0,0,20"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 4. STATUS BAR -->
        <Border Grid.Row="3" Background="#333">
             <DockPanel LastChildFill="False">
                 <TextBlock Text="Ready" Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
                 <TextBlock x:Name="StatusText" Text="Connected" DockPanel.Dock="Right" Foreground="#888" VerticalAlignment="Center" Margin="10,0"/>
             </DockPanel>
        </Border>
        
        <!-- MIXER SELECTION OVERLAY (shows on startup) -->
        <Border x:Name="MixerSelectionOverlay" 
                Background="#DD000000" 
                Visibility="Visible"
                Grid.RowSpan="4"
                Panel.ZIndex="1000">
            <Border Background="#2B2B2B" 
                    Padding="40" 
                    CornerRadius="8"
                    BorderBrush="#555"
                    BorderThickness="1"
                    MaxWidth="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Select ATEM Mixer" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#EEEEEE"
                               Margin="0,0,0,25"
                               HorizontalAlignment="Center"/>
                    
                    <RadioButton x:Name="RadioMiniProISO" 
                                 Content="ATEM Mini Pro ISO (4 inputs)" 
                                 FontSize="16"
                                 Foreground="#DDDDDD"
                                 IsChecked="True"
                                 Margin="0,12"
                                 Padding="8,4"/>
                    
                    <RadioButton x:Name="RadioMiniExtreme" 
                                 Content="ATEM Mini Extreme (8 inputs)" 
                                 FontSize="16"
                                 Foreground="#DDDDDD"
                                 Margin="0,12"
                                 Padding="8,4"/>
                    
                    <RadioButton x:Name="RadioConstellation" 
                                 Content="ATEM 4 M/E Constellation HD (40 inputs)" 
                                 FontSize="16"
                                 Foreground="#DDDDDD"
                                 Margin="0,12"
                                 Padding="8,4"/>
                    
                    <Button Content="Connect to Selected Mixer" 
                            Click="MixerSelection_Click"
                            Margin="0,30,0,0"
                            Padding="20,12"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#0078D4"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1084D8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="Desktop.SuperSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121216"
             Foreground="#E4E4EC"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Sleek Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5" Background="#3E3E4C">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2.5" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D38"/>
                                <Setter Property="Foreground" Value="#FF9800"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#111114"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#22222A"/>
            <Setter Property="BorderBrush" Value="#3A3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="4" Background="#22222A" BorderBrush="#3A3A46" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FF9800"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF9800"/>
                                                <Setter TargetName="Border" Property="Background" Value="#2A2A34"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" Placement="Bottom">
                                <Border x:Name="DropDownBorder" CornerRadius="5" Background="#1C1C22" BorderBrush="#FF9800" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}" MaxHeight="220" Margin="0,2,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.7"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Slider Thumb Style -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Ellipse" Fill="#F4F4F6" Stroke="#FF9800" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ellipse" Property="Fill" Value="#FF9800"/>
                                <Setter TargetName="Ellipse" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Ellipse" Property="Fill" Value="#FFA726"/>
                                <Setter TargetName="Ellipse" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#FF9800"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#2C2C36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="#22222A" BorderBrush="#484856" BorderThickness="1.5" Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 13 4" Stroke="#FF9800" StrokeThickness="2" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9800"/>
                                <Setter TargetName="Box" Property="Background" Value="#2C261E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Box Tab RadioButton Style -->
        <Style x:Key="SSTabButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A1A1B0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="#363642" Background="#202026" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF9800" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666678"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Pill Button Style -->
        <Style x:Key="QuickPillButton" TargetType="Button">
            <Setter Property="Background" Value="#24242C"/>
            <Setter Property="Foreground" Value="#D4D4E0"/>
            <Setter Property="BorderBrush" Value="#3A3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32323E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#111114"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Camera Pill Style -->
        <Style x:Key="QuickPillButtonActive" TargetType="Button" BasedOn="{StaticResource QuickPillButton}">
            <Setter Property="Background" Value="#2D2316"/>
            <Setter Property="Foreground" Value="#FF9800"/>
            <Setter Property="BorderBrush" Value="#FF9800"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Graphical Preset Card Button Style -->
        <Style x:Key="PresetCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="#343440" Padding="8,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#25252C" Offset="0"/>
                                    <GradientStop Color="#1B1B20" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9800"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#30303A" Offset="0"/>
                                            <GradientStop Color="#23232B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFA726"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#3B3B48"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="245"/> <!-- Top: 16:9 Interactive Broadcast Monitor & Quick Layout Bar -->
            <RowDefinition Height="*"/>   <!-- Bottom: Box Studio + Branding & Presets -->
        </Grid.RowDefinitions>

        <!-- ================= TOP: 16:9 INTERACTIVE MONITOR & QUICK PRESET STRIP ================= -->
        <Border Grid.Row="0" Background="#17171C" CornerRadius="8" BorderBrush="#2E2E38" BorderThickness="1" Margin="0,0,0,8" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 16:9 Monitor Viewport -->
                    <ColumnDefinition Width="*"/>    <!-- Quick Layout Presets & Active Box Summary -->
                </Grid.ColumnDefinitions>

                <!-- Left: True 16:9 Interactive Monitor Canvas -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="LIVE 16:9 COMPOSITOR MONITOR" Foreground="#FF9800" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  Drag box to move  •  Drag corners or scroll wheel to resize" Foreground="#888898" FontSize="10" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkSafeGuides" Content="SAFE GUIDES" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="9.5" Checked="ChkSafeGuides_Changed" Unchecked="ChkSafeGuides_Changed"/>
                    </DockPanel>

                    <!-- Fixed 16:9 Aspect Ratio Monitor Frame -->
                    <Border Grid.Row="1" Background="#08080A" CornerRadius="6" BorderBrush="#383846" BorderThickness="1.5" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="CanvasPreview" Width="640" Height="360" Background="#0A0A0E" ClipToBounds="True" SizeChanged="CanvasPreview_SizeChanged"/>
                        </Viewbox>
                    </Border>
                </Grid>

                <!-- Right: Quick Layout Presets Strip -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="1-CLICK LAYOUT PRESETS" Foreground="#E4E4EC" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="SEND TO PVW" Style="{StaticResource QuickPillButton}" Foreground="#00E676" BorderBrush="#00E676" Padding="8,2" Click="SendSuperSourceToPvw_Click" ToolTip="Route SuperSource directly to Hardware Preview"/>
                            <Button Content="● TAKE ON AIR" Style="{StaticResource QuickPillButton}" Background="#4A1218" Foreground="#FF5252" BorderBrush="#FF1744" Padding="8,2" Click="TakeSuperSourceToPgm_Click" ToolTip="Take SuperSource Live on Hardware Program Output"/>
                            <Button Content="RESET" Style="{StaticResource QuickPillButton}" Padding="7,2" Click="Preset4Grid_Click" ToolTip="Reset to default Quad 4-Grid"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <UniformGrid Columns="2" Rows="3" VerticalAlignment="Top">
                            <!-- Preset 1: Quad 4-Grid -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="0,0,4,6" Click="Preset4Grid_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <UniformGrid Columns="2" Rows="2" Margin="2">
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="QUAD 4-GRID" Foreground="#FF9800" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="2x2 Split Screen" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Preset 2: 2-Pop Side-by-Side -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="4,0,0,6" Click="Preset2Pop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <UniformGrid Columns="2" Rows="1" Margin="2,5">
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                            <Border Background="#00E676" CornerRadius="1" Margin="0.8"/>
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="2-POP DUAL" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="Side-by-Side 50%" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Preset 3: Picture-in-Picture -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="0,0,4,6" Click="PresetPIP_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <Canvas>
                                            <Border Width="34" Height="20" Canvas.Left="1" Canvas.Top="1" Background="#333" CornerRadius="1"/>
                                            <Border Width="13" Height="8" Canvas.Left="20" Canvas.Top="11" Background="#FF9800" CornerRadius="1" BorderBrush="#FFF" BorderThickness="0.5"/>
                                        </Canvas>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PIP INSET" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="Full + Corner Cam" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Preset 4: 1 Featured + 3 Stacked -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="4,0,0,6" Click="Preset1Big3Small_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#FF9800" CornerRadius="1" Margin="0.8"/>
                                            <UniformGrid Grid.Column="1" Columns="1" Rows="3">
                                                <Border Background="#00E676" CornerRadius="1" Margin="0.6"/>
                                                <Border Background="#00E676" CornerRadius="1" Margin="0.6"/>
                                                <Border Background="#00E676" CornerRadius="1" Margin="0.6"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="1 HOST + 3 PANEL" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="Featured + 3 Stack" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Preset 5: 3-Up Panel -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="0,0,4,0" Click="Preset3Up_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <UniformGrid Columns="3" Rows="1" Margin="2,5">
                                            <Border Background="#FF9800" CornerRadius="1" Margin="0.6"/>
                                            <Border Background="#00E676" CornerRadius="1" Margin="0.6"/>
                                            <Border Background="#00E5FF" CornerRadius="1" Margin="0.6"/>
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="3-UP TRIO" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="3 Panel Speakers" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Preset 6: Single Center Focus -->
                            <Button Style="{StaticResource PresetCardButton}" Margin="4,0,0,0" Click="PresetSingle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="24" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,8,0">
                                        <Grid Margin="2">
                                            <Border Background="#FF9800" CornerRadius="1" Margin="4,2"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="HERO FRAME" Foreground="#FFF" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="85% Framed Solo" Foreground="#888" FontSize="8.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= BOTTOM: LEFT (BOX & CAMERA STUDIO) | RIGHT (BRANDING, BACKGROUND & ART) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/> <!-- Left: Box & Camera Studio -->
                <ColumnDefinition Width="1.0*"/>  <!-- Right: Branding, Background & Border Studio -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: BOX & CAMERA STUDIO -->
            <Border Grid.Column="0" Background="#17171C" CornerRadius="8" BorderBrush="#2E2E38" BorderThickness="1" Margin="0,0,5,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Box Selector Tabs -->
                        <RowDefinition Height="*"/>    <!-- Camera & Geometry Controls -->
                    </Grid.RowDefinitions>

                    <!-- Box Selector Tabs -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <RadioButton x:Name="TabBox1" Content="BOX 1" Style="{StaticResource SSTabButton}" IsChecked="True" Checked="BoxTab_Checked" Tag="0"/>
                        <RadioButton x:Name="TabBox2" Content="BOX 2" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="1"/>
                        <RadioButton x:Name="TabBox3" Content="BOX 3" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="2"/>
                        <RadioButton x:Name="TabBox4" Content="BOX 4" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="3"/>
                    </UniformGrid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Enable & Source Dropdown Header -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="ChkBoxEnable" Grid.Column="0" Content="ENABLE BOX ON AIR" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Checked="BoxControl_Changed" Unchecked="BoxControl_Changed"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ALL INPUTS:" Foreground="#888" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbBoxSource" Width="155" SelectionChanged="BoxControl_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1-CLICK QUICK CAMERA ASSIGN MATRIX -->
                            <Border Background="#121216" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="1-CLICK CAMERA ASSIGN (AUTO-ENABLES BOX)" Foreground="#9A9AA8" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid x:Name="QuickCameraGrid" Columns="5" Rows="2"/>
                                </StackPanel>
                            </Border>

                            <!-- SIZE WITH 1-CLICK PRESET PILLS -->
                            <Grid Margin="0,0,0,3">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BOX SIZE" Foreground="#B4B4C4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="25%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="0.25"/>
                                    <Button Content="33%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="0.33"/>
                                    <Button Content="50%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="0.50"/>
                                    <Button Content="65%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="0.65"/>
                                    <Button Content="75%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="0.75"/>
                                    <Button Content="100%" Style="{StaticResource QuickPillButton}" Padding="6,1" Click="QuickSize_Click" Tag="1.00"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSizeVal" Text="50%" Foreground="#FF9800" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="SldSize" Minimum="0.10" Maximum="1.0" Value="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>

                            <!-- POSITION X & Y WITH QUICK SNAP ALIGNMENT -->
                            <DockPanel Margin="0,4,0,4">
                                <TextBlock Text="QUICK SNAP:" Foreground="#888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <UniformGrid Columns="5" Rows="1">
                                    <Button Content="↖ TL" Style="{StaticResource QuickPillButton}" Padding="4,2" Click="QuickSnap_Click" Tag="TL" ToolTip="Snap Top-Left Quadrant"/>
                                    <Button Content="↗ TR" Style="{StaticResource QuickPillButton}" Padding="4,2" Click="QuickSnap_Click" Tag="TR" ToolTip="Snap Top-Right Quadrant"/>
                                    <Button Content="✦ CENTER" Style="{StaticResource QuickPillButton}" Padding="4,2" Click="QuickSnap_Click" Tag="C" ToolTip="Snap Center (0, 0)"/>
                                    <Button Content="↙ BL" Style="{StaticResource QuickPillButton}" Padding="4,2" Click="QuickSnap_Click" Tag="BL" ToolTip="Snap Bottom-Left Quadrant"/>
                                    <Button Content="↘ BR" Style="{StaticResource QuickPillButton}" Padding="4,2" Click="QuickSnap_Click" Tag="BR" ToolTip="Snap Bottom-Right Quadrant"/>
                                </UniformGrid>
                            </DockPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Position X -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Grid>
                                        <TextBlock Text="POSITION X" Foreground="#888" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtPosXVal" Text="0.00" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldPosX" Minimum="-16.0" Maximum="16.0" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>

                                <!-- Position Y -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Grid>
                                        <TextBlock Text="POSITION Y" Foreground="#888" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtPosYVal" Text="0.00" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldPosY" Minimum="-9.0" Maximum="9.0" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#2A2A34" Margin="0,4,0,8"/>

                            <!-- Crop Controls -->
                            <DockPanel Margin="0,0,0,6">
                                <CheckBox x:Name="ChkBoxCrop" Content="ENABLE EDGE CROP" Foreground="#FFF" FontWeight="Bold" FontSize="10.5" Checked="BoxControl_Changed" Unchecked="BoxControl_Changed"/>
                                <Button Content="RESET CROP" Style="{StaticResource QuickPillButton}" HorizontalAlignment="Right" Padding="8,1" Click="ResetCrop_Click"/>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Grid>
                                        <TextBlock Text="CROP TOP" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropTopVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropTop" Minimum="0" Maximum="18" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="CROP BOTTOM" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropBottomVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropBottom" Minimum="0" Maximum="18" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Grid>
                                        <TextBlock Text="CROP LEFT" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropLeftVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropLeft" Minimum="0" Maximum="32" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="CROP RIGHT" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropRightVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropRight" Minimum="0" Maximum="32" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: BRANDING, BACKGROUND & BORDER STUDIO -->
            <Border Grid.Column="1" Background="#17171C" CornerRadius="8" BorderBrush="#2E2E38" BorderThickness="1" Margin="5,0,0,0" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="BRANDING, BACKGROUND &amp; BORDER STUDIO" Foreground="#FF9800" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                        <!-- 1. STUDIO BACKGROUND BRANDING THEMES -->
                        <Border Background="#121216" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="BACKGROUND CANVAS THEME" Foreground="#D4D4E0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="🖼 Load Custom Image..." Style="{StaticResource QuickPillButton}" HorizontalAlignment="Right" Padding="8,2" Click="LoadCustomBg_Click" ToolTip="Choose a custom PNG/JPG background image"/>
                                </DockPanel>

                                <UniformGrid Columns="3" Rows="2">
                                    <Button Content="⬛ Studio Grid" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="StudioGrid"/>
                                    <Button Content="🔵 News Blue" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="NewsBlue"/>
                                    <Button Content="🟠 Vidikom Gold" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="VidikomGold"/>
                                    <Button Content="🔴 Live Crimson" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="LiveCrimson"/>
                                    <Button Content="🟢 Arena Green" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="ArenaGreen"/>
                                    <Button Content="🟣 Cyber Violet" Style="{StaticResource QuickPillButton}" Click="BgTheme_Click" Tag="CyberViolet"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 2. BOX FRAME & BORDER BRANDING -->
                        <Border Background="#121216" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="BOX BORDER &amp; BEVEL STYLING" Foreground="#D4D4E0" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBorderWidthVal" Text="2.5 px" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <!-- Color Swatches -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="COLOR:" Foreground="#888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#FF9800" ToolTip="Vidikom Amber">
                                        <Button.Template><ControlTemplate><Border Background="#FF9800" CornerRadius="11" BorderBrush="White" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#FFFFFF" ToolTip="Broadcast White">
                                        <Button.Template><ControlTemplate><Border Background="#FFFFFF" CornerRadius="11" BorderBrush="#666" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#00E5FF" ToolTip="Studio Cyan">
                                        <Button.Template><ControlTemplate><Border Background="#00E5FF" CornerRadius="11" BorderBrush="#444" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#00E676" ToolTip="Signal Emerald">
                                        <Button.Template><ControlTemplate><Border Background="#00E676" CornerRadius="11" BorderBrush="#444" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#FF1744" ToolTip="On-Air Crimson">
                                        <Button.Template><ControlTemplate><Border Background="#FF1744" CornerRadius="11" BorderBrush="#444" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#FFD700" ToolTip="Executive Gold">
                                        <Button.Template><ControlTemplate><Border Background="#FFD700" CornerRadius="11" BorderBrush="#444" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Width="22" Height="22" Margin="2,0" Cursor="Hand" Click="BorderColor_Click" Tag="#525264" ToolTip="Subtle Slate">
                                        <Button.Template><ControlTemplate><Border Background="#525264" CornerRadius="11" BorderBrush="#888" BorderThickness="1.5"/></ControlTemplate></Button.Template>
                                    </Button>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="THICKNESS:" Foreground="#888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="SldBorderWidth" Grid.Column="1" Minimum="0" Maximum="6" Value="2.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="BorderWidth_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. ON-SCREEN BROADCAST BUG / BRANDING BANNER -->
                        <Border Background="#121216" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkShowBrandBug" Content="SHOW BROADCAST BRANDING BUG" IsChecked="True" FontSize="10" FontWeight="Bold" Checked="BrandBug_Changed" Unchecked="BrandBug_Changed"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TITLE / BUG:" Foreground="#888" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtBrandBug" Grid.Column="1" Text="VIDIKOM LIVE" Background="#1C1C22" Foreground="#FFFFFF" BorderBrush="#383846" BorderThickness="1" Padding="6,3" FontSize="11" FontWeight="SemiBold" TextChanged="BrandBug_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. ATEM ART FILL & KEY ROUTING -->
                        <Border Background="#121216" BorderBrush="#282834" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="ATEM HARDWARE ART &amp; KEY ROUTING" Foreground="#D4D4E0" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="ART FILL SOURCE:" Foreground="#888" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbArtFill" Width="165" HorizontalAlignment="Right" SelectionChanged="ArtControl_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="ART KEY SOURCE:" Foreground="#888" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbArtKey" Width="165" HorizontalAlignment="Right" SelectionChanged="ArtControl_Changed"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="LAYER:" Foreground="#888" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="RadArtBackground" Content="BACKGROUND" Foreground="#DDD" FontSize="10" FontWeight="SemiBold" IsChecked="True" Checked="ArtControl_Changed" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RadArtForeground" Content="FOREGROUND (KEYED)" Foreground="#DDD" FontSize="10" FontWeight="SemiBold" Checked="ArtControl_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

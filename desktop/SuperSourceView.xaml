<UserControl x:Class="Desktop.SuperSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121214"
             Foreground="#DDD"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Sleek Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="6" Background="#3E3E42">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark ComboBox Item Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E65100"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="4" Background="#222226" BorderBrush="#3D3D44" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FF9800"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF9800"/>
                                                <Setter TargetName="Border" Property="Background" Value="#2C2C32"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,24,4"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide" Placement="Bottom">
                                <Border x:Name="DropDownBorder" CornerRadius="4" Background="#1E1E22" BorderBrush="#FF9800" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}" MaxHeight="200" Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Slider Thumb Style -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Ellipse" Fill="#CCCCCC" Stroke="#FF9800" StrokeThickness="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ellipse" Property="Fill" Value="#FF9800"/>
                                <Setter TargetName="Ellipse" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Ellipse" Property="Fill" Value="#E65100"/>
                                <Setter TargetName="Ellipse" Property="Stroke" Value="#FFB74D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#FF9800"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#2C2C32"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="#222226" BorderBrush="#44444C" BorderThickness="1.5" Margin="0,0,6,0">
                                <Path x:Name="CheckMark" Data="M 3 8 L 6 11 L 13 4" Stroke="#FF9800" StrokeThickness="2" Visibility="Collapsed" SnapsToDevicePixels="True"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9800"/>
                                <Setter TargetName="Box" Property="Background" Value="#2C2C32"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Box Tab RadioButton Style -->
        <Style x:Key="SSTabButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" BorderBrush="#3A3A3A" Background="#222222" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF9800" Offset="0"/>
                                            <GradientStop Color="#E65100" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Graphical Preset Card Button Style -->
        <Style x:Key="PresetCardButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="#3D3D3D" Padding="8,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A2A2A" Offset="0"/>
                                    <GradientStop Color="#1E1E1E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9800"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#383838" Offset="0"/>
                                            <GradientStop Color="#262626" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFA726"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#444"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Real-time Canvas Visualizer -->
            <RowDefinition Height="*"/>    <!-- Box & Art Parameter Controls -->
        </Grid.RowDefinitions>

        <!-- TOP: REAL-TIME 16:9 MONITOR CANVAS VISUALIZER -->
        <Border Grid.Row="0" Background="#18181B" CornerRadius="8" BorderBrush="#333338" BorderThickness="1" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                    <TextBlock Text="REAL-TIME MONITOR LAYOUT PREVIEW" Foreground="#FF9800" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text=" (Click any box to select)" Foreground="#777" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 16:9 Dark Preview Viewport -->
                <Border Grid.Row="1" Background="#0A0A0C" CornerRadius="6" BorderBrush="#2E2E32" BorderThickness="1" ClipToBounds="True">
                    <Canvas x:Name="CanvasPreview" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="CanvasPreview_SizeChanged"/>
                </Border>
            </Grid>
        </Border>

        <!-- BOTTOM: CONTROLS & PRESETS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/> <!-- Box Controls -->
                <ColumnDefinition Width="1.0*"/>  <!-- Art & Presets -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: BOX CONTROLS -->
            <Border Grid.Column="0" Background="#1A1A1D" CornerRadius="8" BorderBrush="#333338" BorderThickness="1" Margin="0,0,6,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tabs -->
                        <RowDefinition Height="*"/>    <!-- Controls -->
                    </Grid.RowDefinitions>

                    <!-- Box Tabs -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                        <RadioButton x:Name="TabBox1" Content="BOX 1" Style="{StaticResource SSTabButton}" IsChecked="True" Checked="BoxTab_Checked" Tag="0"/>
                        <RadioButton x:Name="TabBox2" Content="BOX 2" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="1"/>
                        <RadioButton x:Name="TabBox3" Content="BOX 3" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="2"/>
                        <RadioButton x:Name="TabBox4" Content="BOX 4" Style="{StaticResource SSTabButton}" Checked="BoxTab_Checked" Tag="3"/>
                    </UniformGrid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- Enable & Source Header (Non-overlapping Grid) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="ChkBoxEnable" Grid.Column="0" Content="ENABLE BOX" Foreground="#FFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Checked="BoxControl_Changed" Unchecked="BoxControl_Changed"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="SOURCE:" Foreground="#888" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbBoxSource" Width="145" SelectionChanged="BoxControl_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#2A2A2E" Margin="0,0,0,10"/>

                            <!-- Position X -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="POSITION X" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPosXVal" Text="0.00" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldPosX" Minimum="-16.0" Maximum="16.0" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>

                            <!-- Position Y -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="POSITION Y" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPosYVal" Text="0.00" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldPosY" Minimum="-9.0" Maximum="9.0" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>

                            <!-- Size -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="SIZE" Foreground="#888" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtSizeVal" Text="50%" Foreground="#FF9800" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SldSize" Minimum="0.0" Maximum="1.0" Value="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="BoxControl_Changed"/>

                            <Separator Background="#2A2A2E" Margin="0,5,0,10"/>

                            <!-- Crop Controls -->
                            <CheckBox x:Name="ChkBoxCrop" Content="ENABLE CROP" Foreground="#FFF" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" Checked="BoxControl_Changed" Unchecked="BoxControl_Changed"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Grid>
                                        <TextBlock Text="CROP TOP" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropTopVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropTop" Minimum="0" Maximum="18" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="CROP BOTTOM" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropBottomVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropBottom" Minimum="0" Maximum="18" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Grid>
                                        <TextBlock Text="CROP LEFT" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropLeftVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropLeft" Minimum="0" Maximum="32" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>

                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="CROP RIGHT" Foreground="#888" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCropRightVal" Text="0.0" Foreground="#AAA" FontSize="9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldCropRight" Minimum="0" Maximum="32" Value="0" TickFrequency="0.1" ValueChanged="BoxControl_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: ART & PRESETS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Art Control Panel -->
                <Border Grid.Row="0" Background="#1A1A1D" CornerRadius="8" BorderBrush="#333338" BorderThickness="1" Margin="6,0,0,6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ART &amp; BORDER CONTROL" Foreground="#FFF" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="FILL:" Foreground="#888" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbArtFill" Width="145" HorizontalAlignment="Right" SelectionChanged="ArtControl_Changed"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="KEY:" Foreground="#888" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbArtKey" Width="145" HorizontalAlignment="Right" SelectionChanged="ArtControl_Changed"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RadArtBackground" Content="BACKGROUND" Foreground="#CCC" FontSize="10" FontWeight="SemiBold" IsChecked="True" Checked="ArtControl_Changed" Margin="0,0,12,0"/>
                            <RadioButton x:Name="RadArtForeground" Content="FOREGROUND" Foreground="#CCC" FontSize="10" FontWeight="SemiBold" Checked="ArtControl_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Presets Panel with Graphical Mini-Diagram Thumbnails -->
                <Border Grid.Row="1" Background="#1A1A1D" CornerRadius="8" BorderBrush="#333338" BorderThickness="1" Margin="6,6,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LAYOUT PRESETS" Foreground="#FFF" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <!-- Preset 1: Quad 4-Grid -->
                                <Button Style="{StaticResource PresetCardButton}" Click="Preset4Grid_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Mini 16:9 Thumbnail Diagram -->
                                        <Border Width="42" Height="26" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
                                            <UniformGrid Columns="2" Rows="2" Margin="2">
                                                <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                            </UniformGrid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="QUAD 4-GRID" Foreground="#FF9800" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="Equal 2x2 grid layout" Foreground="#777" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Preset 2: 2-Pop Side-by-Side -->
                                <Button Style="{StaticResource PresetCardButton}" Click="Preset2Pop_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Mini 16:9 Thumbnail Diagram -->
                                        <Border Width="42" Height="26" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                <Border Grid.Column="1" Background="#FF9800" CornerRadius="1" Margin="1"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="2-POP (SIDE-BY-SIDE)" Foreground="#FFF" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="2 large side-by-side boxes" Foreground="#777" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Preset 3: Picture-in-Picture -->
                                <Button Style="{StaticResource PresetCardButton}" Click="PresetPIP_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Mini 16:9 Thumbnail Diagram -->
                                        <Border Width="42" Height="26" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
                                            <Canvas>
                                                <Border Width="38" Height="22" Canvas.Left="1" Canvas.Top="1" Background="#333" CornerRadius="1"/>
                                                <Border Width="14" Height="9" Canvas.Left="23" Canvas.Top="12" Background="#FF9800" CornerRadius="1" BorderBrush="#FFF" BorderThickness="0.5"/>
                                            </Canvas>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PICTURE-IN-PICTURE (PIP)" Foreground="#FFF" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="Full background + inset box" Foreground="#777" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Preset 4: 1 Featured + 3 Stacked -->
                                <Button Style="{StaticResource PresetCardButton}" Click="Preset1Big3Small_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Mini 16:9 Thumbnail Diagram -->
                                        <Border Width="42" Height="26" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                <UniformGrid Grid.Column="1" Columns="1" Rows="3">
                                                    <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                    <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                    <Border Background="#FF9800" CornerRadius="1" Margin="1"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="1 FEATURED + 3 STACKED" Foreground="#FFF" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="Large left + 3 right stacked" Foreground="#777" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Preset 5: Single Center Focus -->
                                <Button Style="{StaticResource PresetCardButton}" Click="PresetSingle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Mini 16:9 Thumbnail Diagram -->
                                        <Border Width="42" Height="26" Background="#111" CornerRadius="3" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
                                            <Grid Margin="2">
                                                <Border Background="#FF9800" CornerRadius="1" Margin="4,2"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SINGLE CENTER FOCUS" Foreground="#FFF" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="Centered main box focus" Foreground="#777" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

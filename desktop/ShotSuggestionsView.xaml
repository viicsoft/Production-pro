<UserControl x:Class="Desktop.ShotSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>  <!-- Categories -->
            <ColumnDefinition Width="*"/>    <!-- Tiles -->
            <ColumnDefinition Width="220"/>  <!-- Assign to Camera -->
        </Grid.ColumnDefinitions>

        <!-- LEFT: CATEGORIES -->
        <Border Grid.Column="0" Background="#252525" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="10,10,10,5" HorizontalAlignment="Stretch">
                    <TextBlock Text="Categories" Foreground="#CCC" FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <TreeView x:Name="CategoryTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#CCC" Margin="5,0" SelectedItemChanged="CategoryTree_SelectedItemChanged">
                    <!-- Populated dynamically -->
                </TreeView>

                <Button Grid.Row="2" Content="+ Add Category" Background="#333" Foreground="#CCC" BorderThickness="0" Margin="10" Padding="5" Cursor="Hand" Click="AddCategory_Click"/>
            </Grid>
        </Border>

        <!-- CENTER: SUGGESTION TILES -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                <Button Content="+ Add Suggestion" Background="#FFA500" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Padding="15,6" Margin="0,0,10,0" Cursor="Hand" Click="AddSuggestion_Click"/>
                <Button Content="Import" Background="#333" Foreground="#CCC" BorderThickness="0" Padding="15,6" Cursor="Hand" Click="Import_Click" Margin="0,0,5,0"/>
                <Button Content="Export" Background="#333" Foreground="#CCC" BorderThickness="0" Padding="15,6" Cursor="Hand" Click="Export_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="SuggestionsWrap" Margin="10"/>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT: SEND TO CAMERA -->
        <Border Grid.Column="2" Background="#252525" BorderBrush="#333" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Send to Camera" Foreground="#CCC" FontWeight="Bold" FontSize="12" Margin="10,15,10,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CameraList" Margin="10,0">
                        <!-- Populated dynamically -->
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="10">
                    <TextBlock Text="Send Reminder (Text):" Foreground="#888" FontSize="10" Margin="0,0,0,5"/>
                    <TextBox x:Name="ReminderBox" Height="40" TextWrapping="Wrap" Background="#111" Foreground="#CCC" BorderBrush="#333" Padding="5" Margin="0,0,0,10"/>
                    <Button Content="SEND REMINDER" Background="#333" Foreground="#CCC" BorderThickness="0" Padding="10" Cursor="Hand" Click="SendReminder_Click" Margin="0,0,0,10"/>
                    
                    <Button x:Name="SendSuggestionBtn" Content="SEND SUGGESTION" Background="#0F0" Foreground="#000" FontWeight="Bold" BorderThickness="0" Padding="10,15" Cursor="Hand" Click="SendSuggestion_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Desktop.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#141416"
             Foreground="#E4E4E7"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Nested Inner Box Style -->
        <Style x:Key="InnerCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="BorderBrush" Value="#2C2C32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Connect Action Button Style -->
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#009624"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disconnect Action Button Style -->
        <Style x:Key="DisconnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#44444C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF5350"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="*"/>     <!-- 1: Main Body Scroll Area -->
        </Grid.RowDefinitions>

        <!-- ===================================================================== -->
        <!-- 0. TOP HEADER BAR                                                     -->
        <!-- ===================================================================== -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Broadcast Connection SVG Icon -->
                    <Border Width="30" Height="30" Background="#2A2A30" CornerRadius="6" BorderBrush="#3D3D44" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M 7,15 L 11,19 L 15,15 M 11,5 L 11,18 M 5,9 L 2,9 M 20,9 L 17,9 M 15,3 L 13,5 M 7,3 L 9,5" 
                              Stroke="#FF9800" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SWITCHER CONNECTION &amp; HARDWARE" Foreground="#FF9800" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Manage Ethernet LAN, direct USB, and local simulator hardware connection lifecycle" Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Status Pill -->
                <Border x:Name="PillHeaderStatus" Grid.Column="1" Background="#2A2A30" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotHeaderStatus" Width="8" Height="8" Fill="#71717A" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHeaderStatus" Text="DISCONNECTED" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================================================================== -->
        <!-- 1. MAIN CONTENT AREA                                                  -->
        <!-- ===================================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================================= -->
                <!-- LEFT COLUMN: CONNECTION CONFIGURATION & PROFILES              -->
                <!-- ============================================================= -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- CARD 1: CONNECTION SETTINGS -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Section Title -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="CONNECTION CONFIGURATION" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="IP / USB / SIM" Foreground="#71717A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,14"/>

                            <!-- Interface Selection -->
                            <TextBlock Text="COMMUNICATION INTERFACE" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,16">
                                <RadioButton x:Name="RadioAuto" Content="Auto-Detect (USB First, Then Network)" IsChecked="True" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,8" Cursor="Hand" Checked="RadioMode_Checked"/>
                                <RadioButton x:Name="RadioUsb" Content="Direct USB (Blackmagic COM Discovery)" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,8" Cursor="Hand" Checked="RadioMode_Checked"/>
                                <RadioButton x:Name="RadioNetwork" Content="Network (Ethernet IPv4 / Hostname)" Foreground="#E4E4E7" FontSize="12" Margin="0,0,0,8" Cursor="Hand" Checked="RadioMode_Checked"/>
                                <RadioButton x:Name="RadioSimulator" Content="Internal Simulator (In-Memory 127.0.0.1)" Foreground="#E4E4E7" FontSize="12" Cursor="Hand" Checked="RadioMode_Checked"/>
                            </StackPanel>

                            <!-- Target Host / IP Address Input -->
                            <TextBlock Text="SWITCHER IP ADDRESS OR HOSTNAME" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtIpAddress" 
                                     Text="Auto-Detect (USB / Network)" 
                                     IsEnabled="False"
                                     Height="36" 
                                     FontSize="13" 
                                     VerticalContentAlignment="Center" 
                                     Padding="10,6" 
                                     Margin="0,0,0,4"
                                     KeyDown="TxtIpAddress_KeyDown"/>
                            <TextBlock x:Name="TxtIpHint" Text="Auto-detect probes physical USB first, then falls back to default network IP." Foreground="#71717A" FontSize="10" Margin="0,0,0,14"/>

                            <!-- Advanced Network Parameters Expander -->
                            <Expander Header="Advanced Options (Port, Timeout, Reconnect)" Foreground="#888890" FontSize="10" FontWeight="Bold" Margin="0,0,0,16">
                                <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Port -->
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="CONTROL PORT" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtPort" Text="9910" Height="30" FontSize="11" VerticalContentAlignment="Center" IsReadOnly="True" Foreground="#A1A1AA" ToolTip="Default Blackmagic ATEM UDP control protocol port"/>
                                            </StackPanel>

                                            <!-- Timeout -->
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="TIMEOUT" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CmbTimeout" Height="30" SelectedIndex="1">
                                                    <ComboBoxItem Content="3 seconds (Fast)"/>
                                                    <ComboBoxItem Content="5 seconds (Standard)"/>
                                                    <ComboBoxItem Content="10 seconds (Slow LAN)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ChkAutoReconnect" Content="Auto-reconnect on dropped link" IsChecked="True" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- Action Buttons Grid -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnConnect" 
                                        Grid.Column="0" 
                                        Content="⚡ CONNECT" 
                                        Style="{StaticResource ConnectButtonStyle}" 
                                        Height="42" 
                                        Margin="0,0,6,0" 
                                        Click="BtnConnect_Click"/>

                                <Button x:Name="BtnDisconnect" 
                                        Grid.Column="1" 
                                        Content="✕ DISCONNECT" 
                                        Style="{StaticResource DisconnectButtonStyle}" 
                                        Height="42" 
                                        Margin="6,0,0,0" 
                                        IsEnabled="False" 
                                        Click="BtnDisconnect_Click"/>
                            </Grid>

                            <!-- Connection Busy Indicator -->
                            <ProgressBar x:Name="ProgressConnecting" 
                                         Height="4" 
                                         IsIndeterminate="True" 
                                         Visibility="Collapsed" 
                                         Margin="0,10,0,0" 
                                         Foreground="#00E676" 
                                         Background="#222226"/>

                            <!-- Diagnostic & Status Feedback Banner -->
                            <Border x:Name="PnlStatusBanner" 
                                    Background="#141416" 
                                    BorderBrush="#2C2C32" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="12,10" 
                                    Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtStatusBannerIcon" Text="○" FontSize="13" Foreground="#71717A" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtStatusHeadline" Text="Disconnected from Switcher" FontWeight="Bold" FontSize="11" Foreground="#A1A1AA"/>
                                        <TextBlock x:Name="TxtStatusDetails" Text="Enter switcher IP address and click Connect to initialize hardware communication." FontSize="10" Foreground="#71717A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- CARD 2: QUICK CONNECT PROFILES & HISTORY -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="QUICK CONNECT PROFILES" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="PRESETS" Foreground="#71717A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,12"/>

                            <!-- Preset 1: Studio ATEM Mini Pro -->
                            <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Studio ATEM Mini (Default LAN)" FontWeight="Bold" FontSize="11" Foreground="#E4E4E7"/>
                                        <TextBlock Text="192.168.1.240 • Ethernet UDP" FontSize="10" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Load" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Click="BtnProfileAtemDefault_Click"/>
                                </Grid>
                            </Border>

                            <!-- Preset 2: Local In-Memory Simulator -->
                            <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Local Switcher Simulator" FontWeight="Bold" FontSize="11" Foreground="#E4E4E7"/>
                                        <TextBlock Text="127.0.0.1 • In-Memory SimAtem" FontSize="10" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Load" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Click="BtnProfileSimulator_Click"/>
                                </Grid>
                            </Border>

                            <!-- Preset 3: Direct USB Blackmagic -->
                            <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Direct USB Connection" FontWeight="Bold" FontSize="11" Foreground="#E4E4E7"/>
                                        <TextBlock Text="Blackmagic COM Hardware Discovery" FontSize="10" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Load" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Click="BtnProfileUsb_Click"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ============================================================= -->
                <!-- RIGHT COLUMN: CONNECTED HARDWARE TELEMETRY & SPECS            -->
                <!-- ============================================================= -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Health Tag -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="HARDWARE TELEMETRY &amp; DEVICE DETAILS" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                            <Border x:Name="BadgeConnectionHealth" Background="#2A2A30" CornerRadius="3" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtHealthStatus" Text="STANDBY" Foreground="#71717A" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <Border Grid.Row="0" Height="1" Background="#2C2C32" VerticalAlignment="Bottom"/>

                        <!-- Content Area -->
                        <Grid Grid.Row="1" Margin="0,16,0,0">

                            <!-- STATE A: DISCONNECTED STANDBY PLACEHOLDER -->
                            <Grid x:Name="PnlDisconnectedState" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <Border Width="64" Height="64" Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <Path Data="M 12 2 L 12 6 M 6 12 L 2 12 M 22 12 L 18 12 M 12 22 L 12 18 M 16 8 L 8 16 M 8 8 L 16 16" 
                                              Stroke="#55555C" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No Active Switcher Connection" FontSize="15" FontWeight="Bold" Foreground="#888890" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select a connection interface and enter an IP address or hostname to initiate communication with the switcher." 
                                               FontSize="11" Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,8,0,18"/>
                                    <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Padding="14,10" MaxWidth="400">
                                        <StackPanel>
                                            <TextBlock Text="💡 QUICK CONNECTION TIPS" Foreground="#FF9800" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Text="• For local simulator testing, select 'Internal Simulator' and connect to 127.0.0.1." Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Ensure the ATEM switcher and host PC share the same subnet (e.g. 192.168.1.xxx)." Foreground="#A1A1AA" FontSize="10" Margin="0,0,0,3"/>
                                            <TextBlock Text="• Physical USB connection requires BMDSwitcherAPI64.dll driver." Foreground="#A1A1AA" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- STATE B: CONNECTED HARDWARE TELEMETRY -->
                            <Grid x:Name="PnlConnectedState" Visibility="Collapsed">
                                <StackPanel>

                                    <!-- Quick Stat Highlights Row -->
                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <!-- Power Status -->
                                        <Border Style="{StaticResource InnerCardBorderStyle}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="POWER SUPPLY" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtPowerStatus" Text="● OK (Normal)" Foreground="#00E676" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Video Standard -->
                                        <Border Style="{StaticResource InnerCardBorderStyle}" Margin="6,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="VIDEO STANDARD" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtVideoMode" Text="1080p59.94" Foreground="#FF9800" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Connection Uptime -->
                                        <Border Style="{StaticResource InnerCardBorderStyle}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LINK UPTIME" Foreground="#888890" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtUptime" Text="00:00:00" Foreground="#E4E4E7" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Detailed Device Identity Table -->
                                    <Border Style="{StaticResource InnerCardBorderStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="DEVICE IDENTITY &amp; NETWORK TOPOLOGY" Foreground="#FF9800" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Hardware Model:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtDeviceModel" Grid.Column="1" Text="ATEM Mini Pro ISO" FontWeight="Bold" Foreground="#E4E4E7" FontSize="11"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Device Name:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtDeviceName" Grid.Column="1" Text="AtemSimulator" Foreground="#E4E4E7" FontSize="11"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Connected Endpoint:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtDeviceEndpoint" Grid.Column="1" Text="192.168.1.240" Foreground="#E4E4E7" FontSize="11"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Unique Hardware ID:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtDeviceUniqueId" Grid.Column="1" Text="SIM-12345" Foreground="#A1A1AA" FontSize="11" FontFamily="Consolas"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Engine Mode:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtEngineMode" Grid.Column="1" Text="In-Memory Simulator" Foreground="#FF9800" FontSize="11"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Protocol Link State:" Foreground="#888890" FontSize="11"/>
                                                <TextBlock x:Name="TxtLinkStatus" Grid.Column="1" Text="Online &amp; Active (0 Packet Drops)" Foreground="#00E676" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Diagnostic Action Bar -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnRefreshInfo" Content="🔄 Refresh Device Telemetry" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" Click="BtnRefreshInfo_Click"/>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

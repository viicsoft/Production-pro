<UserControl x:Class="Desktop.Views.OutputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1150"
             Background="#141416"
             Foreground="#E4E4E7"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Card Container Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Nested Inner Box Style -->
        <Style x:Key="InnerCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#141416"/>
            <Setter Property="BorderBrush" Value="#2C2C32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Action Button Style (Apply) -->
        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#009624"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#3D3D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="*"/>     <!-- 1: Main Body Scroll Area -->
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 0. TOP HEADER BAR                                                 -->
        <!-- ================================================================= -->
        <Border Grid.Row="0" Background="#1E1E22" BorderBrush="#3D3D44" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#2A2A30" CornerRadius="6" BorderBrush="#3D3D44" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <!-- Video Routing Matrix SVG Icon -->
                        <Path Data="M 4,4 L 12,4 L 12,12 L 4,12 Z M 16,4 L 24,4 L 24,12 L 16,12 Z M 4,16 L 12,16 L 12,24 L 4,24 Z M 16,16 L 24,16 L 24,24 L 16,24 Z" 
                              Stroke="#FF9800" StrokeThickness="1.5" Fill="#332814" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OUTPUT ROUTING &amp; MULTIVIEW CONFIGURATION" Foreground="#FF9800" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Configure auxiliary video bus routes, MultiView layout splits, window source assignments, and core video standard" Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Mode Badge -->
                <Border Grid.Column="1" Background="#2A2A30" BorderBrush="#3D3D44" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00E676" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHeaderVideoMode" Text="1080p5994" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- 1. MAIN CONTENT SCROLLABLE AREA                                   -->
        <!-- ================================================================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: AUX ROUTING & VIDEO MODE ================= -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- CARD 1: AUXILIARY OUTPUT ROUTING -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="AUXILIARY OUTPUTS ROUTING" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="AUX BUS MATRIX" Foreground="#71717A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,14"/>

                            <!-- Aux Output Selection -->
                            <TextBlock Text="SELECT AUXILIARY OUTPUT" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ComboAuxOutputs" Margin="0,0,0,14" SelectionChanged="ComboAuxOutputs_SelectionChanged"/>

                            <!-- Source Input Selection -->
                            <TextBlock Text="ROUTE VIDEO SOURCE TO AUX" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ComboAuxSources" Margin="0,0,0,14"/>

                            <!-- Route Action Button -->
                            <Button x:Name="BtnApplyAuxRoute" Content="ROUTE TO AUXILIARY BUS" Style="{StaticResource ApplyButtonStyle}" Padding="0,9" Margin="0,0,0,14" Click="BtnApplyAuxRoute_Click"/>

                            <!-- Current Aux Routing Summary List -->
                            <TextBlock Text="ACTIVE AUX ROUTING MATRIX" Foreground="#71717A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource InnerCardBorderStyle}">
                                <ItemsControl x:Name="LstAuxStatusSummary">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E4E4E7" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="➔" Foreground="#FF9800" FontSize="11" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SourceName}" Foreground="#00E676" FontWeight="SemiBold" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: VIDEO STANDARD / MODE CONFIGURATION -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="CORE VIDEO STANDARD &amp; RESOLUTION" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="SYSTEM TIMING" Foreground="#71717A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,14"/>

                            <!-- Current Mode Display Box -->
                            <Border Style="{StaticResource InnerCardBorderStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CURRENT ACTIVE VIDEO STANDARD" Foreground="#71717A" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtActiveVideoModeLarge" Text="1080p5994" Foreground="#00E676" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1A3822" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="LOCKED" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Target Standard Dropdown -->
                            <TextBlock Text="SELECT NEW VIDEO STANDARD" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ComboSupportedVideoModes" Margin="0,0,0,14"/>

                            <!-- Apply Button -->
                            <Button x:Name="BtnApplyVideoMode" Content="SET VIDEO STANDARD" Style="{StaticResource ApplyButtonStyle}" Padding="0,9" Click="BtnApplyVideoMode_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ================= RIGHT COLUMN: MULTIVIEW CONFIGURATION ================= -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- MultiView Selector & Split Controls -->
                            <RowDefinition Height="*"/>     <!-- Window Routing Matrix Grid -->
                        </Grid.RowDefinitions>

                        <!-- MultiView Layout Controls -->
                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="MULTIVIEW CONFIGURATION &amp; LAYOUT" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="WINDOW ROUTING MATRIX" Foreground="#71717A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- MultiView Selector -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="MULTIVIEW TARGET" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ComboMultiViewSelect" SelectionChanged="ComboMultiViewSelect_SelectionChanged"/>
                                </StackPanel>

                                <!-- Layout Picker -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="SPLIT LAYOUT" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ComboMultiViewLayout" SelectionChanged="ComboMultiViewLayout_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- PGM / PVW Swap Toggle -->
                            <CheckBox x:Name="ChkSwapPgmPvw" Content="Swap Program and Preview Window Positions" Margin="0,0,0,14" Click="ChkSwapPgmPvw_Click"/>
                            <Border Height="1" Background="#2C2C32" Margin="0,0,0,14"/>
                        </StackPanel>

                        <!-- Windows Routing Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="MULTIVIEW WINDOW SOURCE ASSIGNMENTS (WINDOWS 01–10)" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <ItemsControl x:Name="LstMultiViewWindows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141416" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WindowTitle}" Foreground="{Binding WindowColor}" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding RoleDescription}" Foreground="#71717A" FontSize="10"/>
                                                    </StackPanel>

                                                    <!-- Source Selector ComboBox -->
                                                    <ComboBox Grid.Column="1" 
                                                              ItemsSource="{Binding DataContext.AvailableSourceItems, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                              SelectedValue="{Binding CurrentInputId, Mode=TwoWay}" 
                                                              SelectedValuePath="Id" 
                                                              DisplayMemberPath="DisplayName"
                                                              Margin="10,0"
                                                              SelectionChanged="MvWindowSource_SelectionChanged"
                                                              Tag="{Binding WindowIndex}"/>

                                                    <!-- VU Meter Indicator -->
                                                    <Border Grid.Column="2" Background="{Binding VuMeterBackground}" BorderBrush="{Binding VuMeterBorder}" BorderThickness="1" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VuMeterText}" Foreground="{Binding VuMeterForeground}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="Desktop.MediaPoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B" Foreground="#CCC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: LOCAL LIBRARY -->
        <Border Grid.Column="0" Background="#252525" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Local Library" Foreground="#CCC" FontWeight="Bold" FontSize="12" Margin="10,10,10,5"/>

                <TreeView x:Name="FolderTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#CCC" Margin="5,0"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"/>

                <Border Grid.Row="2" Height="1" Background="#333" Margin="5,0"/>

                <!-- File list from selected folder -->
                <ListBox x:Name="FileList" Grid.Row="3" Background="Transparent" BorderThickness="0" Foreground="#CCC"
                         MaxHeight="120" Margin="5,5" SelectionChanged="FileList_SelectionChanged"
                         MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#AAA"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Preview -->
                <StackPanel Grid.Row="4" Margin="10,5">
                    <TextBlock Text="Preview" Foreground="#888" FontSize="10" Margin="0,0,0,5"/>
                    <Border Background="#111" CornerRadius="4" Height="90">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder" Text="No Selection" Foreground="#555" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER: CLIPS + STILLS -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Clip 1" Foreground="#CCC" FontWeight="Bold" FontSize="11" Margin="0,0,15,0"/>
                    <TextBlock Text="0/100 Frames" Foreground="#666" FontSize="10"/>
                    <TextBlock Text="Clip 2" Foreground="#CCC" FontWeight="Bold" FontSize="11" Margin="40,0,15,0"/>
                    <TextBlock Text="0/300 Frames" Foreground="#666" FontSize="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Border Background="#2A2A2A" CornerRadius="4" Width="130" Height="75" Margin="0,0,8,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Empty" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Background="#2A2A2A" CornerRadius="4" Width="130" Height="75" Margin="0,0,8,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="🎵" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Audio" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Background="#2A2A2A" CornerRadius="4" Width="130" Height="75" Margin="0,0,8,0"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Empty" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Background="#2A2A2A" CornerRadius="4" Width="130" Height="75"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="🎵" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Audio" Foreground="#555" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
                </StackPanel>

                <TextBlock Text="Stills" Foreground="#CCC" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>

                <UniformGrid x:Name="StillsGrid" Columns="4"/>

                <Button Content="Capture Still" HorizontalAlignment="Right" Margin="0,10" Padding="15,6"
                        Background="#333" Foreground="#CCC" BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                        Click="CaptureStill_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: MEDIA PLAYERS -->
        <Border Grid.Column="2" Background="#252525" BorderBrush="#333" BorderThickness="1,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Media Players" Foreground="#CCC" FontWeight="Bold" FontSize="12" Margin="0,5,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#FFA500" Margin="0,0,8,0">
                            <TextBlock Text="1" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Player1Label" Text="Empty" Foreground="#CCC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#111" CornerRadius="4" Height="80" Margin="0,0,0,5">
                        <Grid>
                            <TextBlock x:Name="Player1Placeholder" Text="No Media" Foreground="#444" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="Player1Image" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#FFA500" Margin="0,0,8,0">
                            <TextBlock Text="2" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Player2Label" Text="Empty" Foreground="#CCC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#111" CornerRadius="4" Height="80">
                        <Grid>
                            <TextBlock x:Name="Player2Placeholder" Text="No Media" Foreground="#444" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="Player2Image" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

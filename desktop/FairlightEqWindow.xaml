<Window x:Class="Desktop.FairlightEqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop"
        Title="Fairlight Equalizer" Height="520" Width="820"
        MinWidth="760" MinHeight="480"
        Background="#18181B" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Foreground" Value="#00BCD4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#202025" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF9800" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtChannelTag" Text="CAM 1" Foreground="#111" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="FAIRLIGHT 6-BAND PARAMETRIC EQUALIZER" Foreground="#AAAAAA" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMasterBypass" Content="EQ ACTIVE" Background="#888888" Foreground="#111" FontWeight="Bold" FontSize="10" Padding="12,4" Margin="0,0,8,0" Click="BtnMasterBypass_Click" Cursor="Hand" BorderThickness="0"/>
                    <Button Content="RESET EQ" Background="#33333A" Foreground="#BBB" FontWeight="Bold" FontSize="10" Padding="10,4" Click="BtnResetEq_Click" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EQ Frequency Curve Graph -->
        <Border Grid.Row="1" Background="#101014" BorderBrush="#2A2A35" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12" ClipToBounds="True">
            <Grid x:Name="GraphGrid" SizeChanged="GraphGrid_SizeChanged">
                <Canvas x:Name="EqCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MouseDown="EqCanvas_MouseDown" MouseMove="EqCanvas_MouseMove" MouseUp="EqCanvas_MouseUp"/>
                <!-- Graph Labels -->
                <TextBlock Text="+18 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"/>
                <TextBlock Text="0 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Text="-18 dB" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,4"/>

                <TextBlock Text="20 Hz" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,4"/>
                <TextBlock Text="100 Hz" Foreground="#555" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="140,0,0,4"/>
                <TextBlock Text="1 kHz" Foreground="#555" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <TextBlock Text="10 kHz" Foreground="#555" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,4"/>
                <TextBlock Text="20 kHz" Foreground="#555" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,4"/>
            </Grid>
        </Border>

        <!-- Band Controls (6 Columns) -->
        <Grid Grid.Row="2" x:Name="BandsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Band 1: HPF / Low -->
            <Border Grid.Column="0" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 1: LOW" Foreground="#AAAAAA" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand1" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand1Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand1Freq" Minimum="20" Maximum="500" Value="80" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand1Q" Minimum="0.2" Maximum="5.0" Value="0.7" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Band 2: Low Mid -->
            <Border Grid.Column="1" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 2: L-MID" Foreground="#42A5F5" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand2" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand2Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand2Freq" Minimum="100" Maximum="1500" Value="250" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand2Q" Minimum="0.2" Maximum="5.0" Value="1.0" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Band 3: Mid -->
            <Border Grid.Column="2" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 3: MID" Foreground="#66BB6A" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand3" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand3Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand3Freq" Minimum="400" Maximum="4000" Value="1000" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand3Q" Minimum="0.2" Maximum="5.0" Value="1.4" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Band 4: High Mid -->
            <Border Grid.Column="3" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 4: H-MID" Foreground="#FFA726" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand4" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand4Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand4Freq" Minimum="1500" Maximum="8000" Value="3500" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand4Q" Minimum="0.2" Maximum="5.0" Value="1.4" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Band 5: High Shelf -->
            <Border Grid.Column="4" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 5: HIGH" Foreground="#AB47BC" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand5" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand5Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand5Freq" Minimum="4000" Maximum="16000" Value="8000" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand5Q" Minimum="0.2" Maximum="5.0" Value="1.0" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- Band 6: Low Pass -->
            <Border Grid.Column="5" Background="#1E1E24" CornerRadius="4" Margin="2" Padding="6">
                <StackPanel>
                    <TextBlock Text="BAND 6: LPF" Foreground="#EC407A" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                    <CheckBox x:Name="ChkBand6" Content="Enabled" IsChecked="True" Foreground="#AAA" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,4" Checked="BandControl_Changed" Unchecked="BandControl_Changed"/>
                    <TextBlock Text="GAIN (dB)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand6Gain" Minimum="-18" Maximum="18" Value="0" Unit="dB" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="FREQ (Hz)" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand6Freq" Minimum="8000" Maximum="20000" Value="16000" Unit="Hz" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                    <TextBlock Text="Q FACTOR" Foreground="#777" FontSize="8" HorizontalAlignment="Center"/>
                    <local:KnobControl x:Name="SldBand6Q" Minimum="0.2" Maximum="5.0" Value="0.7" Unit="" ValueChanged="BandKnob_Changed" Margin="0,2"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="APPLY &amp; CLOSE" Background="#00B0FF" Foreground="#111" FontWeight="Bold" FontSize="11" Padding="18,6" Click="BtnApplyClose_Click" Cursor="Hand" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

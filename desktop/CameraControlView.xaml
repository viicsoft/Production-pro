<UserControl x:Class="Desktop.CameraControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#252525" Padding="10,8">
            <TextBlock Text="CAMERA CONTROL" Foreground="#FFA500" FontWeight="Bold" FontSize="14"/>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CameraPanel" Orientation="Horizontal" Margin="10"/>
        </ScrollViewer>
    </Grid>
</UserControl>

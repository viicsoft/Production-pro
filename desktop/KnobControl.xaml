<UserControl x:Class="Desktop.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="KnobGrid" Width="36" Height="36" Cursor="Hand" Background="Transparent" Margin="0,1,0,2"
              PreviewMouseLeftButtonDown="KnobGrid_PreviewMouseLeftButtonDown"
              PreviewMouseMove="KnobGrid_PreviewMouseMove"
              PreviewMouseLeftButtonUp="KnobGrid_PreviewMouseLeftButtonUp"
              PreviewMouseWheel="KnobGrid_PreviewMouseWheel"
              MouseLeftButtonDown="KnobGrid_MouseLeftButtonDown"
              MouseEnter="KnobGrid_MouseEnter"
              MouseLeave="KnobGrid_MouseLeave">
            <Ellipse Width="34" Height="34" Fill="#18181E" Stroke="#2E2E38" StrokeThickness="1"/>
            <Path x:Name="ArcPath" Stroke="#888888" StrokeThickness="2"/>
            <Ellipse Width="24" Height="24" Stroke="#4A4A54" StrokeThickness="1">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.3" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#EEEEF4" Offset="0"/>
                        <GradientStop Color="#D0D0D8" Offset="0.55"/>
                        <GradientStop Color="#9898A2" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Line x:Name="PointerLine" Stroke="#1E1E22" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
        <Border Height="16" Background="#16161C" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="2" Padding="4,0,4,0" Margin="2,2,2,0">
            <TextBlock x:Name="ValText" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </StackPanel>
</UserControl>

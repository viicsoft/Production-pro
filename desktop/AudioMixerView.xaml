<UserControl x:Class="Desktop.AudioMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141416">
    <UserControl.Resources>
        <!-- Authentic Blackmagic Broadcast Fader Slider Style -->
        <Style x:Key="FairlightFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <!-- Recessed Fader Track Slot -->
                            <Border Width="4" Background="#0A0A0D" BorderBrush="#22222A" BorderThickness="1"
                                    CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,14,0,14"/>

                            <!-- Track with Metallic Silver Fader Cap -->
                            <Track x:Name="PART_Track" HorizontalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand" Tag="interactive">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="14" Height="24" Cursor="Hand" Tag="interactive">
                                                    <!-- Metallic Silver Bevelled Fader Cap -->
                                                    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#4A4A56" Tag="interactive">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#ECECF2" Offset="0.0"/>
                                                                <GradientStop Color="#D6D6E0" Offset="0.18"/>
                                                                <GradientStop Color="#B8B8C4" Offset="0.48"/>
                                                                <GradientStop Color="#9E9EAA" Offset="0.52"/>
                                                                <GradientStop Color="#B2B2BE" Offset="0.85"/>
                                                                <GradientStop Color="#888894" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" Direction="270"/>
                                                        </Border.Effect>
                                                        <!-- Center Notch / Groove -->
                                                        <Grid VerticalAlignment="Center">
                                                            <Border Height="1.5" Background="#282830" Margin="2,0"/>
                                                            <Border Height="1" Background="#FFFFFF" Opacity="0.75" Margin="2,1.5,2,0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Slider Style for Headphones Monitor Sliders -->
        <Style x:Key="MiniMonitorSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="2" Background="#0C0C10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,6,0,6"/>
                            <Track x:Name="PART_Track" HorizontalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand" Tag="interactive">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="10" Height="14" CornerRadius="1" Background="#B0B0B8" BorderBrush="#555" BorderThickness="1" Tag="interactive">
                                                    <Border Height="1" Background="#333" VerticalAlignment="Center" Margin="1,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible Button Style for Wave Adjusters -->
        <Style x:Key="InvisibleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1D1D22" BorderBrush="#35353D" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AUDIO MIXER" Foreground="#FF9800" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="#2B2B33" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IN" Foreground="#888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Path Data="M0,5 L10,5 M7,2 L10,5 L7,8" Stroke="#888" StrokeThickness="1.5" Margin="5,0"/>
                            <TextBlock Text="EQ/DYN" Foreground="#00E676" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Path Data="M0,5 L10,5 M7,2 L10,5 L7,8" Stroke="#888" StrokeThickness="1.5" Margin="5,0"/>
                            <TextBlock Text="MASTER OUT" Foreground="#FF9800" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#26262D" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtMasterBal" Text="MASTER BAL: 0.0" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#26262D" CornerRadius="3" Padding="8,3">
                        <TextBlock Text="48kHz / 24-BIT" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Mixer Surface: Pinned Left Labels | Scrollable Channels | Pinned Master -->
        <!-- Main Mixer Surface: Pinned Left Labels | Scrollable Channels | Pinned Master -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/> <!-- Pinned Row Labels -->
                    <ColumnDefinition Width="*"/>  <!-- Scrollable Channel Strips -->
                    <ColumnDefinition Width="Auto"/> <!-- Pinned Master Strip -->
                </Grid.ColumnDefinitions>

            <!-- Column 0: Left Row Labels -->
            <Border Grid.Column="0" Background="#17171A" BorderBrush="#2C2C34" BorderThickness="0,0,1,0" Padding="0,6">
                <StackPanel>
                    <!-- Header Spacer -->
                    <Border Height="28"/>

                    <!-- Input / Eingang Label -->
                    <Border Height="82" VerticalAlignment="Center">
                        <TextBlock Text="Input" Foreground="#787884" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Equalizer Label -->
                    <Border Height="44" VerticalAlignment="Center">
                        <TextBlock Text="Equalizer" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Dynamics / Dynamik Label -->
                    <Border Height="44" VerticalAlignment="Center">
                        <TextBlock Text="Dynamics" Foreground="#76FF03" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </Border>

                    <!-- dB Label -->
                    <Border Height="24" VerticalAlignment="Center">
                        <TextBlock Text="dB" Foreground="#787884" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Fader Scale Spacer (Aligns with fader area) -->
                    <Border Height="188"/>

                    <!-- dB readout spacer -->
                    <Border Height="24"/>

                    <!-- Pan Label -->
                    <Border Height="66" VerticalAlignment="Center">
                        <TextBlock Text="Pan" Foreground="#FFA726" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 1: Central ScrollViewer for Channel Strips -->
            <ScrollViewer x:Name="AudioScrollViewer" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PanningMode="HorizontalOnly"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="ScrollViewer_PreviewMouseLeftButtonUp">
                <StackPanel x:Name="FaderPanel" Orientation="Horizontal" VerticalAlignment="Stretch" Background="Transparent" Margin="2,0"/>
            </ScrollViewer>

            <!-- Column 2: Pinned Master Strip Container -->
            <Border x:Name="MasterPanelContainer" Grid.Column="2" BorderBrush="#2C2C34" BorderThickness="1,0,0,0" Background="#18181D" VerticalAlignment="Stretch"/>
            </Grid>
        </ScrollViewer>




    </Grid>
</UserControl>






